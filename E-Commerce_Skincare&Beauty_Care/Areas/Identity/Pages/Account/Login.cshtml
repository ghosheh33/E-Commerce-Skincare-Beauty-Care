@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<section class="min-h-screen
    px-margin-mobile md:px-margin-desktop
    flex items-center justify-center
    py-12">

    <div class="w-full max-w-5xl
        bg-surface
        rounded-2xl
        overflow-hidden
        shadow-[0_20px_60px_rgba(74,69,62,0.08)]">

        <div class="grid grid-cols-1 lg:grid-cols-2">

            <!-- =========================
                 LEFT SIDE - IMAGE
            ========================== -->
            <div class="hidden lg:block relative min-h-[650px]">

                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBVPQml_dLaUUJN7YH1UwcX2D3sZkDTzybkyHDAaK03Hq91Lm9sfRJhd9LLQGXGGoUXgobuPmW8bMcKXD77eCh2UecD7EULL3LVbZUxJu_QzCo_076YAFf4Q4yPC2-RIouYZ_LNCogiPqg42UGieirXvRCHIK4iUaYl3RUjXHho-CZWU79e-01IuUJQ3cEMRz6kMD0pL_lMRcgcEsu5Yo2j1OBJsorWkd759igxZx0JUSOZjtZmbHyGXQ"
                     alt="Lumina Skin"
                     class="absolute inset-0
                w-full h-full
                object-cover" />


                <div class="absolute inset-0
                    bg-gradient-to-t
                    from-primary/70
                    via-primary/10
                    to-transparent">
                </div>


                <div class="absolute bottom-0 left-0
                    p-10 text-on-primary">

                    <p class="uppercase
                        tracking-[0.2em]
                        text-sm
                        mb-3">
                        Lumina Skin
                    </p>


                    <h2 class="font-display-lg-mobile
                        text-display-lg-mobile
                        mb-4">
                        Welcome back.
                    </h2>


                    <p class="max-w-md opacity-90">
                        Return to your skincare ritual and
                        continue discovering products made
                        for radiant, balanced skin.
                    </p>

                </div>

            </div>



            <!-- =========================
                 RIGHT SIDE - LOGIN FORM
            ========================== -->
            <div class="p-7 sm:p-10 md:p-12
                flex flex-col justify-center">


                <!-- Back Home -->
                <div class="mb-10">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="inline-flex items-center
                        gap-2 text-secondary
                        hover:text-primary
                        transition-colors">

                        <span class="material-symbols-outlined text-sm">
                            arrow_back
                        </span>

                        Back to Home

                    </a>

                </div>



                <!-- Header -->
                <div class="mb-8">

                    <p class="font-label-sm
                        text-label-sm
                        text-secondary
                        uppercase
                        tracking-widest
                        mb-2">
                        Welcome Back
                    </p>


                    <h1 class="font-headline-md
                        text-headline-md
                        text-primary
                        mb-3">
                        Sign In
                    </h1>


                    <p class="font-body-md
                        text-body-md
                        text-on-surface-variant">
                        Sign in to continue your Lumina Skin journey.
                    </p>

                </div>



                <!-- Validation Errors -->
                <div asp-validation-summary="ModelOnly"
                     class="text-red-600 text-sm mb-5">
                </div>



                <!-- =========================
                     LOGIN FORM
                ========================== -->
                <form id="account"
                      method="post"
                      class="space-y-5">


                    <!-- Email -->
                    <div>

                        <label asp-for="Input.Email"
                               class="block
                            font-label-sm
                            text-label-sm
                            text-on-surface-variant
                            mb-2">
                            EMAIL ADDRESS
                        </label>


                        <input asp-for="Input.Email"
                               autocomplete="username"
                               placeholder="name@example.com"
                               class="w-full
                        bg-surface
                        border border-outline
                        rounded-lg
                        px-4 py-3
                        text-on-surface
                        focus:outline-none
                        focus:ring-1
                        focus:ring-primary
                        focus:border-primary
                        transition-colors" />


                        <span asp-validation-for="Input.Email"
                              class="text-red-600
                            text-sm
                            mt-1
                            block">
                        </span>

                    </div>



                    <!-- Password -->
                    <div>

                        <div class="flex
                            items-center
                            justify-between
                            mb-2">

                            <label asp-for="Input.Password"
                                   class="font-label-sm
                                text-label-sm
                                text-on-surface-variant">
                                PASSWORD
                            </label>


                            <a asp-page="./ForgotPassword"
                               class="text-sm
                                text-primary
                                hover:underline">
                                Forgot password?
                            </a>

                        </div>


                        <input asp-for="Input.Password"
                               autocomplete="current-password"
                               placeholder="Enter your password"
                               class="w-full
                        bg-surface
                        border border-outline
                        rounded-lg
                        px-4 py-3
                        text-on-surface
                        focus:outline-none
                        focus:ring-1
                        focus:ring-primary
                        focus:border-primary
                        transition-colors" />


                        <span asp-validation-for="Input.Password"
                              class="text-red-600
                            text-sm
                            mt-1
                            block">
                        </span>

                    </div>



                    <!-- Remember Me -->
                    <div class="flex items-center">

                        <label asp-for="Input.RememberMe"
                               class="flex items-center
                            gap-3
                            cursor-pointer
                            text-on-surface-variant">

                            <input asp-for="Input.RememberMe"
                                   class="rounded
                            border-outline
                            text-primary
                            focus:ring-primary" />

                            <span class="font-body-md text-sm">
                                Remember me
                            </span>

                        </label>

                    </div>



                    <!-- Sign In Button -->
                    <button type="submit"
                            class="w-full
                        bg-primary
                        text-on-primary
                        rounded-full
                        py-3.5
                        font-label-md
                        text-label-md
                        hover:opacity-90
                        transition-opacity">

                        Sign In

                    </button>

                </form>



                <!-- Register -->
                <div class="text-center mt-7">

                    <p class="font-body-md
                        text-body-md
                        text-secondary">

                        Don't have an account?

                        <a asp-page="./Register"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           class="text-primary
                            font-medium
                            hover:underline">

                            Create Account

                        </a>

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}