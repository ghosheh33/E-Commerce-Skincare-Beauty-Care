@{
}
@model E_Commerce_Skincare_Beauty_Care.Models.ApplicationUser

@{
    ViewData["Title"] = "تعديل بيانات المستخدم";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h4 class="mb-0">تعديل بيانات المستخدم</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- إخفاء الـ Id لكي يتم إرساله للسيرفر في الخلفية -->
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label font-weight-bold">الاسم</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-bold">البريد الإلكتروني (للقراءة فقط)</label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label font-weight-bold">العنوان</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="mb-4 form-check form-switch mt-3">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" style="transform: scale(1.5); margin-right: -2.5rem; margin-left: 1rem;">
                    <label class="form-check-label font-weight-bold" for="isActiveSwitch">
                        حساب نشط (إلغاء التحديد سيمنع المستخدم من تسجيل الدخول)
                    </label>
                </div>

                <hr />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">حفظ التعديلات</button>
                    <a asp-action="Users" class="btn btn-outline-secondary px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}