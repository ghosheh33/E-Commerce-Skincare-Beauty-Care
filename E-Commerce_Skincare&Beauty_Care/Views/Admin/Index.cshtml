@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<main class="flex-1 flex flex-col min-w-0 bg-surface-container-lowest">
    <!-- Top App Bar (Mobile) -->
    <header class="md:hidden flex justify-between items-center h-20 px-margin-mobile border-b border-surface-variant bg-surface sticky top-0 z-50">
        <button class="text-on-surface">
            <span class="material-symbols-outlined">menu</span>
        </button>
        <h1 class="font-display-lg-mobile text-headline-sm text-primary">LUMINA</h1>
        <div class="w-8 h-8 rounded-full bg-secondary-container flex items-center justify-center text-primary font-bold">A</div>
    </header>
    <div class="p-margin-mobile md:p-gutter lg:p-margin-desktop max-w-container-max-width mx-auto w-full flex-1 flex flex-col gap-8">
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h2 class="font-headline-md text-headline-md text-on-surface">Dashboard Overview</h2>
                <p class="text-secondary mt-1">Welcome back. Here's what's happening today.</p>
            </div>
            <div class="flex gap-3">
                <button class="px-4 py-2 rounded-full border border-outline text-on-surface font-label-md text-label-md hover:bg-surface-variant transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                    Last 30 Days
                </button>
                <button href="data:text/csv;charset=utf-8,Name,Age,Department%0AJohn,28,Engineering%0AJane,34,Marketing"
                        download="data.csv"
                        class="px-4 py-2 rounded-full bg-primary text-on-primary font-label-md text-label-md hover:opacity-90 transition-opacity flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    Export
                </button>
            </div>
        </div>
        <!-- Stats Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
            <!-- Stat Card 1 -->
            <div class="bg-surface rounded-xl p-6 ambient-shadow flex flex-col gap-4 border border-surface-variant/50">
                <div class="flex justify-between items-start">
                    <div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">group</span>
                    </div>
                    <span class="text-primary font-label-md text-label-md flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">arrow_upward</span> 100%
                    </span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-secondary uppercase tracking-wider mb-1">Total Users</p>
                    <h3 class="font-headline-md text-headline-sm text-on-surface">2</h3>
                </div>
            </div>
            <!-- Stat Card 2 -->
            <div class="bg-surface rounded-xl p-6 ambient-shadow flex flex-col gap-4 border border-surface-variant/50">
                <div class="flex justify-between items-start">
                    <div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">inventory_2</span>
                    </div>
                    <span class="text-secondary font-label-md text-label-md flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">horizontal_rule</span> 0%
                    </span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-secondary uppercase tracking-wider mb-1">Total Products</p>
                    <h3 class="font-headline-md text-headline-sm text-on-surface">15</h3>
                </div>
            </div>
            <!-- Stat Card 3 -->
            <div class="bg-surface rounded-xl p-6 ambient-shadow flex flex-col gap-4 border border-surface-variant/50">
                <div class="flex justify-between items-start">
                    <div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">category</span>
                    </div>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-secondary uppercase tracking-wider mb-1">Total Categories</p>
                    <h3 class="font-headline-md text-headline-sm text-on-surface">8</h3>
                </div>
            </div>
            <!-- Stat Card 4 -->
            <div class="bg-surface rounded-xl p-6 ambient-shadow flex flex-col gap-4 border border-surface-variant/50">
                <div class="flex justify-between items-start">
                    <div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">shopping_bag</span>
                    </div>
                    <span class="text-primary font-label-md text-label-md flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">arrow_upward</span> 8%
                    </span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-secondary uppercase tracking-wider mb-1">Total Orders</p>
                    <h3 class="font-headline-md text-headline-sm text-on-surface">5</h3>
                </div>
            </div>
        </div>
        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
            <!-- Line Chart -->
           
            <!-- Bar Chart -->
          
        </div>
        <!-- Recent Orders Table -->
        <div class="bg-surface rounded-xl ambient-shadow border border-surface-variant/50 overflow-hidden">
            <div class="p-6 border-b border-surface-variant flex justify-between items-center">
                <h3 class="font-headline-sm text-[20px] text-on-surface">Recent Orders</h3>
                <button asp-controller="Orders" asp-action="index" class="text-primary font-label-md text-label-md hover:underline">View All</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container-low border-b border-surface-variant">
                            <th class="py-4 px-6 font-label-sm text-label-sm text-secondary uppercase tracking-wider">Order ID</th>
                            <th class="py-4 px-6 font-label-sm text-label-sm text-secondary uppercase tracking-wider">User Name</th>
                            <th class="py-4 px-6 font-label-sm text-label-sm text-secondary uppercase tracking-wider">Price</th>
                            <th class="py-4 px-6 font-label-sm text-label-sm text-secondary uppercase tracking-wider">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-variant">
                        <tr class="hover:bg-surface-variant/30 transition-colors">
                            <td class="py-4 px-6 font-label-md text-label-md text-on-surface">#1</td>
                            <td class="py-4 px-6 text-on-surface">Mahmoud</td>
                            <td class="py-4 px-6 text-on-surface font-medium">124.00</td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-container/20 text-primary">Completed</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-surface-variant/30 transition-colors">
                            <td class="py-4 px-6 font-label-md text-label-md text-on-surface">#2</td>
                            <td class="py-4 px-6 text-on-surface">Ali</td>
                            <td class="py-4 px-6 text-on-surface font-medium">89.50</td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-container/20 text-primary">Completed</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-surface-variant/30 transition-colors">
                            <td class="py-4 px-6 font-label-md text-label-md text-on-surface">#3</td>
                            <td class="py-4 px-6 text-on-surface">Mahmoud</td>
                            <td class="py-4 px-6 text-on-surface font-medium">210.00</td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-secondary-container text-secondary">Processing</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-surface-variant/30 transition-colors">
                            <td class="py-4 px-6 font-label-md text-label-md text-on-surface">#5</td>
                            <td class="py-4 px-6 text-on-surface">Ali</td>
                            <td class="py-4 px-6 text-on-surface font-medium">45.00</td>
                            <td class="py-4 px-6">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-error-container text-on-error-container">Pending</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

