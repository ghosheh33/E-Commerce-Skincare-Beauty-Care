@model IEnumerable<E_Commerce_Skincare_Beauty_Care.Models.ApplicationUser>

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}



<main class="flex-grow max-w-container-max-width mx-auto w-full">
    <!-- Page Header & Actions -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
            <h1 class="font-headline-md text-headline-md text-on-surface mb-2">Users</h1>
            <p class="font-body-md text-body-md text-secondary">Manage access, roles, and status for all Lumina Skin accounts.</p>
        </div>
        
    </div>

    <!-- Filters & Search Bar -->
    <div class="bg-surface-container-lowest p-6 rounded-xl shadow-[0_4px_20px_rgba(74,69,62,0.05)] mb-8 flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="relative w-full md:w-96">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline" data-icon="search">search</span>
            <input class="w-full pl-10 pr-4 py-3 bg-surface-container-low border border-tertiary-fixed-dim rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors" placeholder="Search by name or email..." type="text" />
        </div>
        <div class="flex items-center gap-4 w-full md:w-auto">
            <select class="w-full md:w-48 p-3 bg-surface-container-low border border-tertiary-fixed-dim rounded-lg font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors appearance-none cursor-pointer" id="role-filter">
                <option value="all">All Roles</option>
                <option value="admin">Admin</option>
                <option value="editor">Editor</option>
                <option value="customer">Customer</option>
            </select>
        </div>
    </div>

    <!-- Product Data Table Container -->
    <div id="productTableContainer" class="bg-surface-container-lowest rounded-xl ambient-shadow overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-surface-variant">
                       
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider w-24">
                            @Html.DisplayNameFor(model => model.Name)
                        </th>
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider w-24">
                            @Html.DisplayNameFor(model => model.Email)
                        </th>
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider w-24">
                            Role
                        </th>
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider w-24">
                            @Html.DisplayNameFor(model => model.Address)
                        </th>
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider w-24">
                            @Html.DisplayNameFor(model => model.CreatedAt)
                        </th>
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-surface-container-lowest/50 transition-colors group">
                           
                            <td class="px-6 py-4">
                                <p class="font-body-md text-body-md font-medium text-on-surface">@Html.DisplayFor(modelItem => item.Name)</p>
                            </td>
                            <td class="px-6 py-4 font-body-md text-body-md">@Html.DisplayFor(modelItem => item.Email)</td>
                           
                            <td class="px-6 py-4">
                                @{
                                    var roles = ViewBag.UserRoles[item.Id] as IList<string>;
                                }

                                @if (roles != null && roles.Any())
                                {
                                    foreach (var role in roles)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mr-1">
                                            @role
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                        Customer
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 font-body-md text-body-md">@Html.DisplayFor(modelItem => item.Address)</td>
                            <td class="px-6 py-4 font-body-md text-body-md">@Html.DisplayFor(modelItem => item.CreatedAt)</td>

                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2 transition-opacity">
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="m-0 p-0 inline-block">
                                        @if (item.IsActive)
                                        {
                                            <button type="submit"
                                                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 hover:bg-green-200 transition-colors border-0 cursor-pointer">
                                                Active
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 hover:bg-red-200 transition-colors border-0 cursor-pointer">
                                                Inactive
                                            </button>
                                        }
                                    </form>
                                   </div>
                            </td>
                            
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-surface-variant flex items-center justify-between bg-surface-container-lowest">
            <p class="font-label-sm text-label-sm text-secondary">
                Showing @ViewData["ShowingFrom"]1 to @ViewData["ShowingTo"]2 of @ViewData["TotalCount"]2 User
            </p>
            <p class="font-label-sm text-label-sm text-secondary">
            </p>
            <p class="font-label-sm text-label-sm text-secondary">
            </p>
            <p class="font-label-sm text-label-sm text-secondary">
            </p>
            <button class="p-2 rounded-lg border border-tertiary-fixed-dim text-secondary hover:text-primary hover:border-primary disabled:opacity-50 transition-colors">
                <span class="material-symbols-outlined text-[20px]">chevron_left</span>
            </button>
            <button class="p-2 rounded-lg border border-tertiary-fixed-dim text-secondary hover:text-primary hover:border-primary transition-colors">
                <span class="material-symbols-outlined text-[20px]">chevron_right</span>
            </button>
        </div>
    </div>
    </div>
</main>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');

        searchInput.addEventListener('input', function () {
            let query = this.value;

            fetch(`/users/Index?searchString=${encodeURIComponent(query)}`)
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newContainer = doc.getElementById('productTableContainer');

                    if (newContainer) {
                        document.getElementById('productTableContainer').innerHTML = newContainer.innerHTML;
                    }
                })
                .catch(error => console.error('Error:', error));
        });
    </script>
}