@model Product


@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex items-center justify-between border-b border-surface-variant">
    <h1 class="font-headline-sm text-headline-sm text-primary">Add New Product</h1>
</div>

    
<form asp-action="Create">
    <div asp-validation-summary="All" class="text-danger font-bold mb-4"></div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class=" flex flex-col md:flex-row gap-8">
        <!-- Left Column: Form Fields -->
        <div class="flex-1 space-y-6">
            
            <div>
                <label asp-for="Name" class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase tracking-wider" for="productName">Product Name</label>
                <input asp-for="Name" class="w-full bg-surface-container-lowest border border-tertiary/30 rounded-DEFAULT px-4 py-3 font-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" placeholder="e.g. Radiance Serum" type="text">
            </div>
            <!-- Category -->
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase tracking-wider" for="category">Category</label>
                <div class="relative">
                    <select class="w-full bg-surface-container-lowest border border-tertiary/30 rounded-DEFAULT px-4 py-3 font-body-md text-on-surface appearance-none focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
                         asp-for="CatalogId" class="form-control" asp-items="ViewBag.CatalogId"></select>
                    
                </div>
            </div>
            <!-- Description -->
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase tracking-wider" for="description">Description</label>
                <input asp-for="Description" class="w-full bg-surface-container-lowest border border-tertiary/30 rounded-DEFAULT px-4 py-3 font-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors resize-none" placeholder="Briefly">
            </div>
            <!-- Price & Stock Row -->
            <div class="flex flex-col sm:flex-row gap-6">
                <div class="flex-1">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase tracking-wider" for="price">Price ($)</label>
                    <input asp-for="Price" class="w-full bg-surface-container-lowest border border-tertiary/30 rounded-DEFAULT px-4 py-3 font-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" min="0" placeholder="0.00" step="0.01">
                </div>
                <div class="flex-1">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase tracking-wider" for="stock">Stock Quantity</label>
                    <input asp-for="StockQuantity" class="w-full bg-surface-container-lowest border border-tertiary/30 rounded-DEFAULT px-4 py-3 font-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors" min="0" placeholder="0">
                </div>
            </div>
        </div>

        <!-- Right Column: Media Upload (Main & Secondary Inputs) -->

        <div class="w-full md:w-1/3 flex flex-col space-y-6">
            <!-- Main Image Input Section -->
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase tracking-wider">Main Image</label>
                <label id="mainImageDropzone" class="relative overflow-hidden border-2 border-dashed border-tertiary/30 rounded-lg flex flex-col items-center justify-center p-4 bg-surface-container hover:bg-surface-container-high transition-colors cursor-pointer group h-40">
                    <div id="mainImagePlaceholder" class="flex flex-col items-center justify-center">
                        <span class="material-symbols-outlined text-3xl text-secondary group-hover:text-primary transition-colors mb-2" data-icon="star">star</span>
                        <span class="font-label-md text-label-md text-on-surface-variant text-center mb-1">Upload Main Image</span>
                        <span class="font-label-sm text-label-sm text-secondary text-center">Featured product view</span>
                    </div>
                    <img id="mainImagePreview" class="absolute inset-0 w-full h-full object-cover hidden" alt="Main Image Preview">
                    <input type="file" id="mainImage" accept="image/*" class="hidden">
                </label>
            </div>

            <!-- Secondary Images Input Section -->
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase tracking-wider">Secondary Images</label>
                <label class="border-2 border-dashed border-tertiary/30 rounded-lg flex flex-col items-center justify-center p-4 bg-surface-container hover:bg-surface-container-high transition-colors cursor-pointer group">
                    <span class="material-symbols-outlined text-3xl text-secondary group-hover:text-primary transition-colors mb-2" data-icon="add_photo_alternate">add_photo_alternate</span>
                    <span class="font-label-md text-label-md text-on-surface-variant text-center mb-1">Add Gallery Images</span>
                    <span class="font-label-sm text-label-sm text-secondary text-center">Multiple angles / details</span>
                    <input type="file" id="secondaryImages" accept="image/*" multiple class="hidden">
                </label>
                <!-- Preview Area for Secondary Images -->
                <div id="secondaryPreviewContainer" class="mt-3 grid grid-cols-3 gap-2">
                    <div class="aspect-square bg-surface-container rounded border border-surface-variant flex items-center justify-center overflow-hidden">
                        <span class="material-symbols-outlined text-secondary/50 text-xl" data-icon="image">image</span>
                    </div>
                    <div class="aspect-square bg-surface-container rounded border border-surface-variant flex items-center justify-center overflow-hidden">
                        <span class="material-symbols-outlined text-secondary/50 text-xl" data-icon="image">image</span>
                    </div>
                    <div class="aspect-square bg-surface-container rounded border border-surface-variant flex items-center justify-center overflow-hidden">
                        <span class="material-symbols-outlined text-secondary/50 text-xl" data-icon="image">image</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
    
    <!-- Footer -->
        <button class="px-6 py-3 bg-primary text-on-primary font-label-md text-label-md rounded-DEFAULT hover:opacity-90 transition-opacity duration-200 shadow-sm flex items-center gap-2" type="submit">
            <span class="material-symbols-outlined text-[18px]" data-icon="check">check</span>
            Add Product
        </button>
   
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const mainImageInput = document.getElementById('mainImage');
        const mainImagePreview = document.getElementById('mainImagePreview');
        const mainImagePlaceholder = document.getElementById('mainImagePlaceholder');

        mainImageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    mainImagePreview.src = e.target.result;
                    mainImagePreview.classList.remove('hidden');
                    mainImagePlaceholder.classList.add('hidden');
                }
                reader.readAsDataURL(file);
            }
        });

        // Secondary Images Preview
        const secondaryImagesInput = document.getElementById('secondaryImages');
        const secondaryPreviewContainer = document.getElementById('secondaryPreviewContainer');

        secondaryImagesInput.addEventListener('change', function(e) {
            const files = Array.from(e.target.files);
            if (files.length > 0) {
                secondaryPreviewContainer.innerHTML = ''; // Clear old placeholders
                files.forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const div = document.createElement('div');
                        div.className = 'aspect-square bg-surface-container rounded border border-surface-variant flex items-center justify-center overflow-hidden';
                        div.innerHTML = `
    <img src="${e.target.result}" class="w-full h-full object-cover" alt="Secondary Image">`;
                    secondaryPreviewContainer.appendChild(div);
                }
                reader.readAsDataURL(file);
            });
        }
    });
    </script>
}