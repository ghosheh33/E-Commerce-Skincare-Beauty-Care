@model IEnumerable<Product>

@{
    ViewData["Title"] = "Shop";
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";

    var catalogs = ViewBag.Catalogs as IEnumerable<Catalog>
                   ?? new List<Catalog>();

    string search = ViewBag.Search as string ?? "";

    int? selectedCatalogId = ViewBag.CatalogId == null
        ? null
        : (int?)ViewBag.CatalogId;

    string sort = ViewBag.Sort as string ?? "";

    var searchSuggestions =
        ViewBag.SearchSuggestions as IEnumerable<string>
        ?? new List<string>();
}


<section class="pt-32 pb-section-gap
    px-margin-mobile md:px-margin-desktop
    max-w-container-max-width mx-auto">


    <!-- =====================================
         PAGE HEADER
    ====================================== -->
    <div class="mb-12">

        <p class="font-label-sm text-label-sm
            text-secondary uppercase
            tracking-widest mb-3">
            Lumina Collection
        </p>


        <h1 class="font-display-lg-mobile md:font-display-lg
            text-display-lg-mobile md:text-display-lg
            text-primary">
            Shop All
        </h1>


        <p class="font-body-md text-body-md
            text-on-surface-variant
            mt-4 max-w-xl">
            Discover skincare essentials crafted for a calm,
            radiant daily ritual.
        </p>

    </div>



    <!-- =====================================
         SHOP GRID
    ====================================== -->
    <div class="grid grid-cols-1
        md:grid-cols-[220px_1fr]
        gap-12">


        <!-- =====================================
             CATEGORY FILTER
        ====================================== -->
        <aside class="sticky top-24 h-fit self-start">

            <h2 class="font-headline-sm
                text-headline-sm
                text-on-surface
                mb-6">
                Categories
            </h2>


            <div class="space-y-4
                font-body-md
                text-body-md">


                <!-- All Products -->
                <a asp-controller="Store"
                   asp-action="Index"
                   asp-route-search="@search"
                   asp-route-sort="@sort"
                   class="block
                    text-left
                    w-full
                    @(selectedCatalogId == null
                       ? "text-primary font-semibold"
                       : "text-secondary")
                    hover:text-primary
                    transition-colors">

                    All Skincare

                </a>



                <!-- Categories -->
                @foreach (var catalog in catalogs)
                {
                    <a asp-controller="Store"
                       asp-action="Index"
                       asp-route-catalogId="@catalog.Id"
                       asp-route-search="@search"
                       asp-route-sort="@sort"
                       class="block
                        text-left
                        w-full
                        @(selectedCatalogId == catalog.Id
                           ? "text-primary font-semibold"
                           : "text-secondary")
                        hover:text-primary
                        transition-colors">

                        @catalog.Name

                    </a>
                }

            </div>



            <!-- Clear Filters -->
            <a asp-controller="Store"
               asp-action="Index"
               class="inline-flex
                items-center
                gap-2
                mt-8
                text-sm
                text-secondary
                hover:text-primary
                hover:underline
                transition-colors">

                <span class="material-symbols-outlined text-lg">
                    filter_alt_off
                </span>

                Clear Filters

            </a>

        </aside>



        <!-- =====================================
             RIGHT SIDE
        ====================================== -->
        <div>


            <!-- =====================================
                 SEARCH + SORT
            ====================================== -->
            <form asp-controller="Store"
                  asp-action="Index"
                  method="get">


                <!-- Keep selected category -->
                @if (selectedCatalogId.HasValue)
                {
                    <input type="hidden"
                           name="catalogId"
                           value="@selectedCatalogId.Value" />
                }


                <div class="flex
                    flex-col
                    sm:flex-row
                    justify-between
                    items-center
                    gap-4
                    bg-surface-container-lowest
                    p-4
                    rounded-xl
                    border border-surface-variant
                    mb-10">


                    <!-- SEARCH -->
                    <div class="relative flex-1 w-full">

                        <span class="material-symbols-outlined
                            absolute
                            left-4
                            top-1/2
                            -translate-y-1/2
                            text-secondary
                            pointer-events-none">
                            search
                        </span>


                        <input type="text"
                               name="search"
                               value="@search"
                               list="searchSuggestions"
                               autocomplete="off"
                               placeholder="Search products or categories..."
                               class="w-full
                        pl-12 pr-4
                        py-3.5
                        bg-surface-container-low
                        border border-transparent
                        focus:border-primary
                        focus:bg-surface
                        rounded-xl
                        outline-none
                        transition-all duration-200" />


                        <!-- Autocomplete -->
                        <datalist id="searchSuggestions">

                            @foreach (var suggestion in searchSuggestions)
                            {
                                <option value="@suggestion"></option>
                            }

                        </datalist>

                    </div>



                    <!-- SORT -->
                    <div class="relative
                        w-full
                        sm:w-[230px]">


                        <span class="material-symbols-outlined
                            absolute
                            left-4
                            top-1/2
                            -translate-y-1/2
                            text-secondary
                            pointer-events-none">
                            sort
                        </span>


                        <select name="sort"
                                onchange="this.form.submit()"
                                class="w-full
                            appearance-none
                            pl-12 pr-12
                            py-3.5
                            bg-surface
                            text-on-surface
                            border border-outline
                            rounded-xl
                            outline-none
                            cursor-pointer
                            hover:border-primary
                            focus:border-primary
                            transition-all duration-200">


                            @if (string.IsNullOrEmpty(sort))
                            {
                                <option value="" selected>
                                    Newest
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    Newest
                                </option>
                            }


                            @if (sort == "price-low")
                            {
                                <option value="price-low" selected>
                                    Price: Low to High
                                </option>
                            }
                            else
                            {
                                <option value="price-low">
                                    Price: Low to High
                                </option>
                            }


                            @if (sort == "price-high")
                            {
                                <option value="price-high" selected>
                                    Price: High to Low
                                </option>
                            }
                            else
                            {
                                <option value="price-high">
                                    Price: High to Low
                                </option>
                            }

                        </select>


                        <span class="material-symbols-outlined
                            absolute
                            right-4
                            top-1/2
                            -translate-y-1/2
                            text-secondary
                            pointer-events-none">
                            expand_more
                        </span>

                    </div>



                    <!-- Search Button -->
                    <button type="submit"
                            class="w-full
                        sm:w-auto
                        inline-flex
                        items-center
                        justify-center
                        gap-2
                        bg-primary
                        text-on-primary
                        px-6 py-3.5
                        rounded-xl
                        font-label-md
                        text-label-md
                        hover:opacity-90
                        transition-opacity">

                        <span class="material-symbols-outlined text-lg">
                            search
                        </span>

                        Search

                    </button>

                </div>

            </form>



            <!-- =====================================
                 COLLECTION HEADER
            ====================================== -->
            <div class="flex
                flex-col
                sm:flex-row
                sm:justify-between
                sm:items-end
                gap-4
                mb-8">


                <div>

                    <h2 class="font-headline-md
                        text-headline-md
                        text-on-surface">
                        The Collection
                    </h2>


                    <p class="font-body-md
                        text-body-md
                        text-secondary
                        mt-2">
                        Discover our curated skincare collection.
                    </p>

                </div>


                <div class="font-label-sm
                    text-label-sm
                    text-secondary">

                    @Model.Count()
                    @(Model.Count() == 1 ? "Product" : "Products")

                </div>

            </div>



            <!-- =====================================
                 PRODUCTS
            ====================================== -->
            @if (Model != null && Model.Any())
            {
                <div class="grid
                    grid-cols-1
                    sm:grid-cols-2
                    lg:grid-cols-3
                    gap-6">


                    @foreach (var product in Model)
                    {
                        var mainImage =
                            product.Images
                                   .FirstOrDefault(i => i.IsMainImage)
                            ?? product.Images.FirstOrDefault();


                        var approvedReviews =
                            product.Reviews
                                   .Where(r => r.IsApproved)
                                   .ToList();


                        var rating =
                            approvedReviews.Any()
                                ? approvedReviews.Average(r => r.Rating)
                                : 0;


                        <!-- =====================================
                             PRODUCT CARD
                        ====================================== -->
                        <article class="bg-surface
                            rounded-xl
                            p-5
                            flex flex-col
                            shadow-[0_4px_20px_rgba(74,69,62,0.05)]
                            hover:shadow-[0_8px_30px_rgba(74,69,62,0.09)]
                            transition-shadow duration-300
                            group">


                            <!-- PRODUCT IMAGE -->
                            <div class="relative
                                aspect-[4/5]
                                overflow-hidden
                                rounded-lg
                                bg-surface-container-low
                                mb-5">


                                @if (mainImage != null)
                                {
                                    <img src="@mainImage.ImageUrl"
                                         alt="@product.Name"
                                         class="w-full
                                    h-full
                                    object-cover
                                    group-hover:scale-105
                                    transition-transform
                                    duration-500" />
                                }
                                else
                                {
                                    <div class="w-full
                                        h-full
                                        flex
                                        items-center
                                        justify-center
                                        text-secondary">

                                        <span class="material-symbols-outlined
                                            text-5xl">
                                            skincare
                                        </span>

                                    </div>
                                }



                                <!-- =====================================
                                     WISHLIST BUTTON
                                ====================================== -->
                                <button type="button"
                                        class="wishlist-btn
                                    absolute
                                    top-3
                                    right-3
                                    bg-surface/85
                                    backdrop-blur-sm
                                    rounded-full
                                    p-2
                                    text-secondary
                                    hover:text-primary
                                    hover:scale-105
                                    transition-all duration-200"
                                        data-product-id="@product.Id"
                                        aria-label="Add to wishlist">

                                    <span class="material-symbols-outlined wishlist-icon"
                                          style="font-variation-settings:'FILL' 0;">
                                        favorite
                                    </span>

                                </button>

                            </div>



                            <!-- CATEGORY -->
                            <span class="font-label-sm
                                text-label-sm
                                text-secondary
                                uppercase
                                tracking-wider">

                                @product.Catalog?.Name

                            </span>



                            <!-- NAME + PRICE -->
                            <div class="flex
                                justify-between
                                items-start
                                gap-3
                                mt-2">


                                <h3 class="font-headline-sm
                                    text-headline-sm
                                    text-on-surface">

                                    <a asp-controller="Details" asp-action="index" asp-route-id="@product.Id">@product.Name</a>

                                </h3>


                                <span class="font-label-md
                                    text-label-md
                                    whitespace-nowrap">

                                    $@product.Price.ToString("0.00")

                                </span>

                            </div>

                            <!-- RATING -->
                            <div class="flex
                                items-center
                                gap-2
                                mb-5
                                mt-auto">


                                <span class="material-symbols-outlined
                                    text-primary
                                    text-sm"
                                      style="font-variation-settings:'FILL' 1;">

                                    star

                                </span>


                                <span class="text-sm">
                                    @rating.ToString("0.0")
                                </span>


                                <span class="text-secondary text-sm">
                                    (@approvedReviews.Count reviews)
                                </span>

                            </div>



                            <!-- =====================================
                                 VIEW DETAILS
                            ====================================== -->
                            <a asp-controller="Details"
                               asp-action="Index"
                               asp-route-id="@product.Id"
                               class="w-full
                                inline-flex
                                items-center
                                justify-center
                                gap-2
                                border
                                border-primary
                                text-primary
                                py-3
                                rounded-full
                                mb-3
                                font-label-md
                                text-label-md
                                hover:bg-primary
                                hover:text-on-primary
                                transition-all">

                                <span class="material-symbols-outlined text-lg">
                                    visibility
                                </span>

                                View Details

                            </a>



                            <!-- =====================================
                                 ADD TO CART
                            ====================================== -->
                            <form asp-controller="Cart"
                                  asp-action="AddToCart"
                                  method="post"
                                  class="w-full">


                                <input type="hidden"
                                       name="productId"
                                       value="@product.Id" />


                                <input type="hidden"
                                       name="quantity"
                                       value="1" />


                                <button type="submit"
                                        class="w-full
                                    inline-flex
                                    items-center
                                    justify-center
                                    gap-2
                                    border
                                    border-outline
                                    py-3
                                    rounded-full
                                    font-label-md
                                    text-label-md
                                    hover:bg-primary
                                    hover:text-on-primary
                                    hover:border-primary
                                    transition-all">

                                    <span class="material-symbols-outlined text-lg">
                                        shopping_bag
                                    </span>

                                    Add to Cart

                                </button>

                            </form>

                        </article>
                    }

                </div>
            }
            else
            {
                <!-- =====================================
                     NO PRODUCTS
                ====================================== -->
                <div class="text-center
                    py-24
                    bg-surface-container-low
                    rounded-xl">


                    <span class="material-symbols-outlined
                        text-5xl
                        text-secondary
                        mb-4">

                        search_off

                    </span>


                    <h3 class="font-headline-sm
                        text-headline-sm
                        mb-2">

                        No products found

                    </h3>


                    <p class="text-secondary mb-6">

                        Try changing your search or category.

                    </p>


                    <a asp-controller="Store"
                       asp-action="Index"
                       class="inline-flex
                        items-center
                        justify-center
                        bg-primary
                        text-on-primary
                        px-6
                        py-3
                        rounded-full
                        hover:opacity-90
                        transition-opacity">

                        View All Products

                    </a>

                </div>
            }

        </div>

    </div>

</section>



<!-- =====================================
     WISHLIST AJAX
===================================== -->
<script>

    document.addEventListener("DOMContentLoaded", function() {

        const wishlistButtons =
            document.querySelectorAll(".wishlist-btn");


        wishlistButtons.forEach(function(button) {

            button.addEventListener("click", async function() {

                const productId =
                    this.dataset.productId;

                const icon =
                    this.querySelector(".wishlist-icon");


                // Prevent multiple clicks while request is running
                this.disabled = true;


                try {

                    const response = await fetch(
                        '@Url.Action("ToggleWishlist", "Wishlist")',
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded"
                            },

                            body:
                                "productId=" +
                                encodeURIComponent(productId)
                        }
                    );


                    if (!response.ok) {

                        throw new Error(
                            "Wishlist request failed."
                        );

                    }


                    const data =
                        await response.json();


                    if (data.success) {

                        // Product was added
                        if (data.isAdded) {

                            icon.style.fontVariationSettings =
                                "'FILL' 1";

                            this.classList.remove(
                                "text-secondary"
                            );

                            this.classList.add(
                                "text-primary"
                            );

                            this.setAttribute(
                                "aria-label",
                                "Remove from wishlist"
                            );

                        }

                        // Product was removed
                        else {

                            icon.style.fontVariationSettings =
                                "'FILL' 0";

                            this.classList.remove(
                                "text-primary"
                            );

                            this.classList.add(
                                "text-secondary"
                            );

                            this.setAttribute(
                                "aria-label",
                                "Add to wishlist"
                            );

                        }

                    }

                }
                catch (error) {

                    console.error(
                        "Wishlist error:",
                        error
                    );

                }
                finally {

                    this.disabled = false;

                }

            });

        });

    });

</script>