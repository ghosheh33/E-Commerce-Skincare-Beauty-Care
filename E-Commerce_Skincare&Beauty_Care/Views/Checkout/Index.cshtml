@model E_Commerce_Skincare_Beauty_Care.ViewModels.ShoppingCart

@{
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";
    ViewData["Title"] = "Checkout - Lumina Skin";
}

<main class="flex-grow pt-32 pb-margin-desktop px-margin-mobile md:px-margin-desktop max-w-container-max-width mx-auto w-full">
    <form asp-controller="Checkout" asp-action="ProcessOrder" method="post">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">

            <!-- Left Column: Checkout Steps -->
            <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-unit">

                <!-- Progress Header -->
                <div class="flex items-center gap-2 mb-8 font-label-md text-label-md text-secondary">
                    <span class="text-primary font-semibold">Information</span>
                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    <span>Shipping</span>
                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    <span>Payment</span>
                </div>

                <!-- Step 1: Contact Information -->
                <div class="bg-surface-container-lowest p-8 rounded-xl shadow-[0_10px_40px_-10px_rgba(74,69,62,0.05)] border border-surface-variant">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Contact Information</h2>
                    </div>
                    <div class="space-y-6">
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="email">Email</label>
                            <input name="email" id="email" value="@User.Identity?.Name" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface" placeholder="your@email.com" type="email" readonly>
                        </div>
                        <div class="flex items-center gap-2">
                            <input name="subscribeToNewsletter" id="subscribeToNewsletter" class="rounded border-tertiary/30 text-primary focus:ring-primary h-4 w-4" type="checkbox">
                            <label class="font-label-md text-label-md text-on-surface-variant cursor-pointer" for="subscribeToNewsletter">Email me with news and offers</label>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Shipping Address -->
                <div class="bg-surface-container-lowest p-8 rounded-xl shadow-[0_10px_40px_-10px_rgba(74,69,62,0.05)] border border-surface-variant mt-6">
                    <h2 class="font-headline-sm text-headline-sm text-on-surface mb-6">Shipping Address</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="firstName">First Name</label>
                            <input name="firstName" id="firstName" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface" type="text" required>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="lastName">Last Name</label>
                            <input name="lastName" id="lastName" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface" type="text" required>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="shippingAddress">Address</label>
                            <input name="shippingAddress" id="shippingAddress" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface" type="text" required>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="city">City</label>
                            <input name="city" id="city" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface" type="text" required>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="country">Country</label>
                            <select name="country" id="country" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface appearance-none">
                                <option value="Jordan">Jordan</option>
                                <option value="United States">United States</option>
                                <option value="United Kingdom">United Kingdom</option>
                            </select>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="phoneNumber">Phone</label>
                            <input name="phoneNumber" id="phoneNumber" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface" type="tel" required>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Payment -->
                <div class="bg-surface-container-lowest p-8 rounded-xl shadow-[0_10px_40px_-10px_rgba(74,69,62,0.05)] border border-surface-variant mt-6 relative overflow-hidden">
                    <h2 class="font-headline-sm text-headline-sm text-on-surface mb-2">Payment</h2>
                    <p class="font-body-md text-body-md text-secondary mb-6">All transactions are secure and encrypted.</p>

                    <div class="border border-tertiary/30 rounded-xl overflow-hidden mb-6 bg-surface-bright">
                        <div class="p-4 border-b border-tertiary/20 flex items-center justify-between bg-primary-fixed/20">
                            <div class="flex items-center gap-3">
                                <div class="w-4 h-4 rounded-full border-4 border-primary bg-white"></div>
                                <span class="font-label-md text-label-md text-on-surface">Credit Card</span>
                            </div>
                            <div class="flex gap-2 opacity-60">
                                <span class="material-symbols-outlined">credit_card</span>
                            </div>
                        </div>

                        <div class="p-6 bg-surface-bright grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="md:col-span-2">
                                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="cardNumber">Card Number</label>
                                <div class="relative">
                                    <input name="cardNumber" id="cardNumber" class="w-full bg-transparent border border-tertiary/30 rounded-lg pl-4 pr-12 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface font-mono" placeholder="0000 0000 0000 0000" type="text">
                                    <span class="material-symbols-outlined absolute right-4 top-3 text-secondary">credit_card</span>
                                </div>
                            </div>
                            <div>
                                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="expDate">Expiration Date (MM/YY)</label>
                                <input name="expDate" id="expDate" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface font-mono" placeholder="MM/YY" type="text">
                            </div>
                            <div>
                                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="cvv">Security Code</label>
                                <input name="cvv" id="cvv" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface font-mono" placeholder="CVV" type="text">
                            </div>
                            <div class="md:col-span-2">
                                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2" for="nameOnCard">Name on Card</label>
                                <input name="nameOnCard" id="nameOnCard" class="w-full bg-transparent border border-tertiary/30 rounded-lg px-4 py-3 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-on-surface" type="text">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Dynamic Order Summary -->
            <div class="lg:col-span-5 xl:col-span-4 sticky top-28">
                <div class="bg-surface-container-low p-8 rounded-xl shadow-[0_20px_60px_-15px_rgba(74,69,62,0.08)]">
                    <h2 class="font-headline-sm text-headline-sm text-on-surface mb-6">Order Summary</h2>

                    <!-- Dynamic Cart Items -->
                    <div class="space-y-6 mb-8 border-b border-tertiary/20 pb-8">
                        @foreach (var item in Model.Items)
                        {
                            var imgUrl = string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-product.jpg" : item.ImageUrl;
                            <div class="flex items-center gap-4">
                                <div class="w-20 h-20 rounded-lg bg-surface-variant flex-shrink-0 relative overflow-hidden">
                                    <img class="w-full h-full object-cover" src="@imgUrl" alt="@item.ProductName">
                                    <div class="absolute -top-2 -right-2 bg-secondary text-on-secondary font-label-sm text-label-sm w-6 h-6 rounded-full flex items-center justify-center border-2 border-surface-container-low z-10">
                                        @item.Quantity
                                    </div>
                                </div>
                                <div class="flex-grow">
                                    <h3 class="font-label-md text-label-md text-on-surface">@item.ProductName</h3>
                                </div>
                                <div class="font-label-md text-label-md text-on-surface">
                                    $@item.Total.ToString("F2")
                                </div>
                            </div>
                        }
                    </div>

                    

                    <!-- Dynamic Totals Calculation -->
                    <div class="space-y-4 mb-8">
                        <div class="flex justify-between font-body-md text-body-md text-secondary">
                            <span>Subtotal</span>
                            <span class="text-on-surface">$@Model.GrandTotal.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between font-body-md text-body-md text-secondary">
                            <span>Shipping</span>
                            <span class="text-on-surface">Free</span>
                        </div>
                        <div class="h-px w-full bg-tertiary/20 my-4"></div>
                        <div class="flex justify-between items-end">
                            <span class="font-headline-sm text-headline-sm text-on-surface">Total</span>
                            <div class="text-right">
                                <span class="font-label-sm text-label-sm text-secondary mr-2">USD</span>
                                <span class="font-headline-md text-headline-md text-on-surface">$@Model.GrandTotal.ToString("F2")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Action Button -->
                    <form asp-controller="Checkout" asp-action="ProcessOrder" method="post">
                        @Html.AntiForgeryToken()

                        <!-- خيارات الدفع أو البيانات -->
                        <input type="hidden" name="paymentMethod" value="Credit Card" />

                        <!-- زر إتمام الشراء -->
                        <button type="submit" class="w-full bg-primary text-on-primary py-4 rounded-full font-label-md hover:bg-primary-container transition-colors">
                            Complete Purchase
                        </button>
                    </form>

                    <p class="text-center mt-4 font-label-sm text-label-sm text-secondary flex items-center justify-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">shield</span>
                        Guaranteed safe & secure checkout
                    </p>
                </div>
            </div>

        </div>
    </form>
</main>