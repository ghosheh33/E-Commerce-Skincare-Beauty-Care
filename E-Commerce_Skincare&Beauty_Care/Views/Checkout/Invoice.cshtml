@model Order

@{
    Layout = null; // نلغي الـ Layout الرئيسي لضمان الحفاظ على ديزاين الفاتورة المخصص والطباعة بشكل نظيف
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Order Invoice #LS-@Model.Id - Lumina Skin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "tertiary-fixed": "#e6e2dc",
                        "on-background": "#1c1b1b",
                        "on-error-container": "#93000a",
                        "on-surface": "#1c1b1b",
                        "on-secondary-container": "#636360",
                        "tertiary-container": "#76746f",
                        "inverse-on-surface": "#f3f0ef",
                        "primary-fixed-dim": "#bbcbb8",
                        "surface-tint": "#546253",
                        "on-primary": "#ffffff",
                        "surface": "#fcf9f8",
                        "primary-fixed": "#d7e7d3",
                        "on-tertiary-container": "#fffbff",
                        "surface-container-high": "#eae7e7",
                        "secondary-fixed-dim": "#c8c6c3",
                        "surface-bright": "#fcf9f8",
                        "on-secondary": "#ffffff",
                        "primary": "#516050",
                        "on-primary-fixed": "#121f12",
                        "on-primary-fixed-variant": "#3c4a3c",
                        "on-tertiary": "#ffffff",
                        "surface-container-highest": "#e5e2e1",
                        "background": "#fcf9f8",
                        "tertiary": "#5e5c57",
                        "secondary-container": "#e1dfdc",
                        "surface-container": "#f0eded",
                        "outline": "#747872",
                        "error": "#ba1a1a",
                        "inverse-surface": "#313030",
                        "on-tertiary-fixed-variant": "#484742",
                        "surface-dim": "#dcd9d9",
                        "inverse-primary": "#bbcbb8",
                        "on-secondary-fixed-variant": "#474744",
                        "secondary-fixed": "#e4e2de",
                        "surface-container-lowest": "#ffffff",
                        "on-secondary-fixed": "#1b1c1a",
                        "tertiary-fixed-dim": "#c9c6c0",
                        "on-primary-container": "#f7fff2",
                        "outline-variant": "#c4c8c0",
                        "secondary": "#5e5e5c",
                        "primary-container": "#6a7868",
                        "on-surface-variant": "#444842",
                        "on-error": "#ffffff",
                        "surface-container-low": "#f6f3f2",
                        "on-tertiary-fixed": "#1c1c18",
                        "error-container": "#ffdad6",
                        "surface-variant": "#e5e2e1"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-max-width": "1280px",
                        "gutter": "24px",
                        "unit": "8px",
                        "margin-mobile": "20px",
                        "margin-desktop": "64px",
                        "section-gap": "60px"
                    },
                    "fontFamily": {
                        "headline-sm": ["Playfair Display"],
                        "body-lg": ["Inter"],
                        "display-lg-mobile": ["Playfair Display"],
                        "label-sm": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-md": ["Playfair Display"],
                        "label-md": ["Inter"],
                        "display-lg": ["Playfair Display"]
                    },
                    "fontSize": {
                        "headline-sm": ["24px", { "lineHeight": "1.3", "fontWeight": "500" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "label-sm": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.08em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "headline-md": ["32px", { "lineHeight": "1.2", "fontWeight": "500" }],
                        "label-md": ["14px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "500" }],
                        "display-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
    <style>
        @@media print {
            body {
                background: white !important;
            }

            .no-print {
                display: none !important;
            }

            .print-border {
                border-color: #000 !important;
            }

            .print-text {
                color: #000 !important;
            }
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body-md min-h-screen flex flex-col md:flex-row">

    <!-- Main Content -->
    <main class="flex-1 w-full max-w-container-max-width mx-auto px-margin-mobile md:px-margin-desktop py-12">

        <!-- Action Bar (No Print) -->
        <div class="no-print flex justify-between items-center mb-12 max-w-3xl mx-auto">
            <a class="text-on-surface-variant hover:text-primary transition-colors flex items-center font-label-md text-label-md group" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined mr-2 transition-transform group-hover:-translate-x-1" style="font-variation-settings: 'FILL' 0;">arrow_back</span>
                Return to Dashboard
            </a>
            <button class="bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md py-3 px-6 rounded-DEFAULT transition-all duration-200 flex items-center" onclick="window.print()">
                <span class="material-symbols-outlined mr-2" style="font-variation-settings: 'FILL' 1;">print</span>
                Print Invoice
            </button>
        </div>

        <!-- Invoice Document -->
        <div class="bg-surface-container-lowest p-8 md:p-16 rounded-xl shadow-[0_10px_40px_-10px_rgba(74,69,62,0.08)] print:shadow-none print:p-0 max-w-3xl mx-auto border border-outline-variant/20 print:border-none">

            <!-- Header -->
            <header class="flex flex-col md:flex-row justify-between items-start md:items-end border-b border-outline-variant/30 print-border pb-8 mb-8">
                <div>
                    <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary print-text tracking-tight mb-2">LUMINA SKIN</h1>
                    <p class="font-label-sm text-label-sm text-on-surface-variant print-text">Order #LS-@Model.Id</p>
                </div>
                <div class="text-left md:text-right mt-6 md:mt-0">
                    <p class="font-body-md text-body-md text-on-surface print-text font-medium">Invoice Date</p>
                    <p class="font-body-md text-body-md text-on-surface-variant print-text">@Model.OrderDate.ToString("MMMM dd, yyyy")</p>
                </div>
            </header>

            <!-- Customer & Shipping Info -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                <div>
                    <h2 class="font-label-sm text-label-sm text-on-surface-variant print-text mb-4 uppercase tracking-widest">Billed To</h2>
                    <p class="font-body-md text-body-md text-on-surface print-text font-medium mb-1">@(Model.User?.UserName ?? "Valued Customer")</p>
                    <p class="font-body-md text-body-md text-on-surface-variant print-text leading-relaxed">
                        @(Model.User?.Email ?? "N/A")<br>
                        Payment Method: @(Model.PaymentMethod ?? "Credit Card")
                    </p>
                </div>
                <div>
                    <h2 class="font-label-sm text-label-sm text-on-surface-variant print-text mb-4 uppercase tracking-widest">Order Status</h2>
                    <p class="font-body-md text-body-md text-on-surface print-text font-medium mb-1">Status: @Model.State</p>
                    <p class="font-body-md text-body-md text-on-surface-variant print-text leading-relaxed">
                        Standard Shipping<br>
                        Estimated Delivery: 3-5 Business Days
                    </p>
                </div>
            </div>

            <!-- Items Table -->
            <div class="mb-12 overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-outline-variant/30 print-border">
                            <th class="py-4 font-label-sm text-label-sm text-on-surface-variant print-text uppercase tracking-widest w-1/2">Product</th>
                            <th class="py-4 font-label-sm text-label-sm text-on-surface-variant print-text uppercase tracking-widest text-center">Qty</th>
                            <th class="py-4 font-label-sm text-label-sm text-on-surface-variant print-text uppercase tracking-widest text-right">Price</th>
                            <th class="py-4 font-label-sm text-label-sm text-on-surface-variant print-text uppercase tracking-widest text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody class="font-body-md text-body-md text-on-surface print-text">
                        @if (Model.OrderItems != null && Model.OrderItems.Any())
                        {
                            foreach (var item in Model.OrderItems)
                            {
                                var itemTotal = item.Quantity * item.PriceAtPurchase;
                                <tr class="border-b border-surface-container/50 print-border">
                                    <td class="py-6">
                                        <span class="font-medium">@(item.Product?.Name ?? "Product Item")</span>
                                    </td>
                                    <td class="py-6 text-center">@item.Quantity</td>
                                    <td class="py-6 text-right">$@item.PriceAtPurchase.ToString("F2")</td>
                                    <td class="py-6 text-right font-medium">$@itemTotal.ToString("F2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Totals -->
            <div class="flex justify-end">
                <div class="w-full md:w-1/2 space-y-3">
                    <div class="flex justify-between font-body-md text-body-md text-on-surface-variant print-text">
                        <span>Subtotal</span>
                        <span>$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between font-body-md text-body-md text-on-surface-variant print-text">
                        <span>Shipping (Standard)</span>
                        <span>$0.00</span>
                    </div>
                    <div class="flex justify-between font-headline-sm text-headline-sm text-primary print-text pt-4 border-t border-outline-variant/30 print-border">
                        <span>Total</span>
                        <span>$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <!-- Footer Notes -->
            <div class="mt-16 pt-8 border-t border-outline-variant/30 print-border text-center">
                <p class="font-label-sm text-label-sm text-on-surface-variant print-text uppercase tracking-widest mb-2">Thank you for your purchase.</p>
                <p class="font-body-md text-body-md text-on-surface-variant print-text text-sm">For questions regarding your order, please contact support@luminaskin.com</p>
            </div>

        </div>
    </main>

</body>
</html>