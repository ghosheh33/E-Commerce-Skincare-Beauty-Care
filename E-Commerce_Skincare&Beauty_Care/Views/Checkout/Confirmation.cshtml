@model Order

@{
    Layout = null; // إغلاق الـ Layout الرئيسي لمنع تداخل الهيدر
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Lumina Skin - Order Success</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,1,0" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#e5e2e1",
                        "primary-fixed": "#d7e7d3",
                        "on-surface": "#1c1b1b",
                        "surface": "#fcf9f8",
                        "on-primary": "#ffffff",
                        "on-background": "#1c1b1b",
                        "outline": "#747872",
                        "primary-container": "#3c4a3c",
                        "background": "#fcf9f8",
                        "on-surface-variant": "#444842",
                        "primary": "#516050",
                        "secondary-fixed": "#e4e2de",
                        "on-secondary-container": "#636360"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-sm": ["Playfair Display"],
                        "display-lg": ["Playfair Display"],
                        "label-sm": ["Inter"],
                        "headline-md": ["Playfair Display"]
                    }
                }
            }
        }
    </script>

    <style>
        .ambient-shadow {
            box-shadow: 0 20px 40px rgba(74, 69, 62, 0.08);
        }

        .fade-in-up {
            animation: fadeInUp 0.8s ease-out forwards;
            opacity: 0;
            transform: translateY(20px);
        }

        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .delay-100 {
            animation-delay: 0.1s;
        }

        .delay-300 {
            animation-delay: 0.3s;
        }

        .glass-panel {
            background: rgba(252, 249, 248, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="bg-background text-on-background antialiased min-h-screen flex flex-col items-center justify-center relative overflow-hidden m-0 p-0">

    <!-- Background Image -->
    <div class="absolute inset-0 z-0 opacity-40">
        <div class="bg-cover bg-center bg-no-repeat w-full h-full" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDdYSjJtcD37UIKitfjmL5vKNsmLJwDYt7P1vzMw4JeZbBjIPGth4P9QFwijMOoyT4WqveCW7tq3DoUQfnn8kvOJAIoj5RULyOuaStWZqyHncObl_ik5VrNnBQ-r_F_SjcUEGO2iAv5XooN-vylIBjqPEoaDAjHZHvbby9KY8dyfj8oSe9xQdATyCTPEQ7_RCrU_1t-2V8NiwZyrJG4sD9fuDh-lUFM0FAzGAs5bxKhwpDBfCCZPnjIig')"></div>
    </div>

    <!-- Main Container -->
    <main class="relative z-10 w-full max-w-xl px-4 py-12 flex flex-col items-center text-center">

        <!-- Logo -->
        <div class="mb-8 fade-in-up">
            <span class="font-headline-md text-3xl md:text-4xl tracking-tight text-primary font-serif">LUMINA SKIN</span>
        </div>

        <!-- Success Card -->
        <div class="glass-panel w-full rounded-2xl p-8 md:p-12 ambient-shadow fade-in-up delay-100 border border-surface-variant/50">

            <!-- Checkmark Icon -->
            <div class="w-14 h-14 mx-auto mb-6 bg-primary-fixed rounded-full flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-3xl">check_circle</span>
            </div>

            <h1 class="font-headline-md text-2xl md:text-3xl text-on-surface mb-3">Thank You for Your Order</h1>

            <p class="font-body-md text-sm md:text-base text-on-surface-variant mb-6 max-w-sm mx-auto leading-relaxed">
                Your journey to radiant skin begins here. We've received your order and are lovingly preparing it for shipment.
            </p>

            <!-- Order Reference Box -->
            <div class="bg-surface/80 rounded-xl p-4 mb-6 inline-block w-full max-w-xs border border-secondary-fixed">
                <span class="text-xs text-on-secondary-container block mb-1 uppercase tracking-widest font-medium">Order Reference ID</span>
                <span class="font-headline-sm text-xl text-primary font-semibold">#LS-@Model.Id</span>
            </div>

            <p class="font-body-md text-xs md:text-sm text-on-surface-variant mb-8 max-w-sm mx-auto">
                A confirmation email with your receipt and tracking details will arrive in your inbox shortly.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
                <a asp-controller="Home" asp-action="Index" class="px-6 py-3 bg-primary text-on-primary rounded-full text-xs font-semibold hover:bg-primary-container transition-all duration-200 w-full sm:w-auto text-center">
                    Continue Shopping
                </a>

                <a asp-controller="Checkout" asp-action="Invoice" asp-route-id="@Model.Id" class="px-6 py-3 bg-transparent border border-outline/50 text-on-surface rounded-full text-xs font-semibold hover:bg-surface-variant/40 transition-all duration-200 w-full sm:w-auto text-center">
                    View Order Details
                </a>
            </div>
        </div>

        <!-- Footer Text -->
        <div class="mt-8 fade-in-up delay-300">
            <p class="text-xs text-on-surface-variant uppercase tracking-widest">
                Need Assistance? <a class="text-primary font-semibold hover:underline ml-1" href="#">Contact Support</a>
            </p>
        </div>
    </main>

</body>
</html>