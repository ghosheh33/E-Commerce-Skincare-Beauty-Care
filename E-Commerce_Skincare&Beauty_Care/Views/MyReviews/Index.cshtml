@model IEnumerable<Review>

@{
    ViewData["Title"] = "My Reviews";
    var products = ViewData["Products"] as List<Product>;
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";

}

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

<script id="tailwind-config">
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                "colors": {
                    "surface-container-low": "#f6f3f2",
                    "on-background": "#1c1b1b",
                    "surface-variant": "#e5e2e1",
                    "primary-fixed": "#d7e7d3",
                    "primary": "#516050",
                    "on-surface": "#1c1b1b",
                    "secondary": "#5e5e5c",
                    "background": "#fcf9f8",
                    "outline-variant": "#c4c8c0",
                    "surface-container-lowest": "#ffffff"
                }
            }
        }
    }
</script>

<div class="flex-grow pt-8 pb-16 flex max-w-7xl mx-auto w-full px-6 gap-12">
    <!-- SideNavBar -->
    <aside class="hidden md:flex bg-surface-container-low h-[calc(100vh-120px)] w-64 rounded-r-xl shadow-sm flex-col p-6 space-y-2 sticky top-24 shrink-0">
        <div class="mb-8">
            <h2 class="font-display-lg text-xl text-primary font-bold">Your Sanctuary</h2>
            <p class="text-xs text-secondary mt-1">Manage your routine</p>
        </div>
        <nav class="flex flex-col gap-2 text-sm">
            <a class="flex items-center gap-3 p-3 text-secondary hover:bg-surface-variant/50 rounded-lg transition-colors"
               asp-controller="Checkout" asp-action="MyOrders">
                <span class="material-symbols-outlined">package_2</span>
                My Orders
            </a>
            <a class="flex items-center gap-3 p-3 text-secondary hover:bg-surface-variant/50 rounded-lg transition-colors"
               asp-controller="Wishlist" asp-action="Index">
                <span class="material-symbols-outlined">favorite</span>
                My Wishlist
            </a>
            <a class="flex items-center gap-3 p-3 bg-primary-fixed text-primary font-semibold rounded-lg"
               asp-controller="MyReviews" asp-action="Index">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">rate_review</span>
                My Reviews
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 w-full max-w-3xl mx-auto">
        <div class="mb-10">
            <h1 class="text-3xl text-primary mb-2 font-serif">Share Your Ritual</h1>
            <p class="text-secondary text-sm">Your experiences illuminate the path for others.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 p-4 rounded-lg bg-primary-fixed text-primary text-sm font-medium">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Review Form -->
        <section class="bg-surface-container-lowest rounded-2xl p-8 shadow-md mb-12 border border-surface-variant/30">
            <form asp-controller="MyReviews" asp-action="Create" method="post" class="space-y-6">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-xs text-secondary uppercase tracking-widest mb-2">Select Purchased Product</label>
                    <select name="ProductId" required class="w-full bg-background border border-outline-variant rounded-lg p-3 text-sm focus:ring-1 focus:ring-primary">
                        <option value="" disabled selected>Choose a purchased product to review...</option>
                        @if (products != null && products.Any())
                        {
                            foreach (var prod in products)
                            {
                                <option value="@prod.Id">@prod.Name</option>
                            }
                        }
                        else
                        {
                            <option value="" disabled>No purchased products found</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs text-secondary uppercase tracking-widest mb-2">Overall Experience</label>
                    <input type="hidden" name="Rating" id="rating-input" value="5" />
                    <div class="flex gap-2 text-outline-variant cursor-pointer" id="star-rating">
                        <span class="material-symbols-outlined text-3xl" data-val="1">star</span>
                        <span class="material-symbols-outlined text-3xl" data-val="2">star</span>
                        <span class="material-symbols-outlined text-3xl" data-val="3">star</span>
                        <span class="material-symbols-outlined text-3xl" data-val="4">star</span>
                        <span class="material-symbols-outlined text-3xl" data-val="5">star</span>
                    </div>
                </div>

                <div>
                    <label class="block text-xs text-secondary uppercase tracking-widest mb-2">Your Story</label>
                    <textarea name="Comment" required rows="4" class="w-full bg-background border border-outline-variant rounded-lg p-3 text-sm focus:ring-1 focus:ring-primary" placeholder="Describe the texture, scent..."></textarea>
                </div>

                <div class="flex justify-end">
                    <button type="submit" class="bg-primary text-white px-6 py-3 rounded-lg text-xs font-semibold hover:opacity-90">
                        Submit Review
                    </button>
                </div>
            </form>
        </section>

        <!-- Past Reviews -->
        <section>
            <h2 class="text-xl text-primary font-serif mb-6 border-b pb-2">Past Reflections</h2>
            <div class="space-y-4">
                @if (!Model.Any())
                {
                    <p class="text-secondary text-sm">You haven't submitted any reviews yet.</p>
                }
                else
                {
                    foreach (var rev in Model)
                    {
                        <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-surface-variant/30 flex gap-5 items-start">
                            <!-- Product Image -->
                            <div class="w-24 h-24 rounded-xl overflow-hidden shrink-0 bg-surface-variant">
                                @{
                                    var mainImg = rev.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                    // أو إذا كان اسم حقل الصورة داخل ProductImage هو ImagePath أو Url عدله هنا
                                }
                                @if (!string.IsNullOrEmpty(mainImg))
                                {
                                    <img src="@mainImg" alt="@rev.Product?.Name" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary text-xs">No Image</div>
                                }
                            </div>

                            <!-- Review Content -->
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between items-start mb-1">
                                    <div>
                                        <h3 class="font-semibold text-base text-on-surface">@rev.Product?.Name</h3>
                                        <p class="text-xs text-secondary mt-0.5">
                                            @(rev.IsApproved ? "Published " : "Submitted ")@rev.CreatedAt.ToString("MMM dd, yyyy")
                                        </p>
                                    </div>

                                    <!-- Badge Status -->
                                    <div>
                                        @if (rev.IsApproved)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-[#e2ece0] text-[#3b533a]">
                                                <span class="material-symbols-outlined text-sm">check_circle</span>
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-[#eae8e6] text-[#636160]">
                                                <span class="w-2 h-2 rounded-full bg-[#8c8a88]"></span>
                                                Pending Approval
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Rating Stars -->
                                <div class="flex text-[#4c5b4b] gap-0.5 my-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' @(i <= rev.Rating ? 1 : 0);">star</span>
                                    }
                                </div>

                                <!-- Comment -->
                                <p class="text-xs text-secondary leading-relaxed line-clamp-3">
                                    "@rev.Comment"
                                </p>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const starsContainer = document.getElementById('star-rating');
        const ratingInput = document.getElementById('rating-input');
        if(starsContainer) {
            const stars = Array.from(starsContainer.children);
            let currentRating = 5;
            updateStars(currentRating);

            stars.forEach((star, index) => {
                star.addEventListener('click', () => {
                    currentRating = index + 1;
                    ratingInput.value = currentRating;
                    updateStars(currentRating);
                });
            });

            function updateStars(rating) {
                stars.forEach((s, i) => {
                    if(i < rating) {
                        s.style.fontVariationSettings = "'FILL' 1";
                        s.classList.add('text-primary');
                        s.classList.remove('text-outline-variant');
                    } else {
                        s.style.fontVariationSettings = "'FILL' 0";
                        s.classList.remove('text-primary');
                        s.classList.add('text-outline-variant');
                    }
                });
            }
        }
    });
</script>