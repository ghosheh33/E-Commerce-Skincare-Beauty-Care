@model IEnumerable<Wishlist>

@{
    ViewData["Title"] = "My Wishlist";
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";

}

<!-- Main Content Area with SideNav -->
<div class="flex flex-1 pt-20 md:pt-28 pb-margin-desktop md:max-w-container-max-width md:mx-auto w-full">
    <!-- SideNavBar -->
    <aside class="hidden md:flex bg-surface-container-low shadow-[10px_0_30px_rgba(74,69,62,0.03)] h-screen w-64 rounded-r-xl flex-col p-gutter space-y-unit sticky top-28">
        <div class="mb-8 px-4">
            <h2 class="font-display-lg text-display-lg text-primary mb-2">Your Sanctuary</h2>
            <p class="font-body-md text-body-md text-secondary">Manage your routine</p>
        </div>
        <nav class="flex flex-col gap-2 text-sm">
            <a class="flex items-center gap-3 p-3 text-secondary hover:bg-surface-variant/50 rounded-lg transition-colors"
               asp-controller="Checkout" asp-action="MyOrders">
                <span class="material-symbols-outlined">package_2</span>
                My Orders
            </a>
            <a class="flex items-center gap-4 px-4 py-3 bg-primary-fixed text-on-primary-fixed-variant font-semibold rounded-lg font-label-md text-label-md transition-colors active:scale-[0.98] transition-transform"
               asp-controller="Wishlist" asp-action="Index">
                <span class="material-symbols-outlined">favorite</span>
                My Wishlist
            </a>
            <a class="flex items-center gap-3 p-3 text-secondary hover:bg-surface-variant/50 rounded-lg transition-colors"
               asp-controller="MyReviews" asp-action="Index">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">rate_review</span>
                My Reviews
            </a>
        </nav>
    </aside>

    <!-- Wishlist Canvas -->
    <main class="flex-1 px-margin-mobile md:px-margin-desktop py-8 w-full">
        <!-- Mobile Header (Hidden on Desktop) -->
        <div class="md:hidden mb-8">
            <h1 class="font-display-lg-mobile text-display-lg-mobile text-primary mb-2">My Wishlist</h1>
            <p class="text-secondary">Your curated collection of skincare essentials.</p>
        </div>

        <!-- Desktop Header -->
        <div class="hidden md:flex justify-between items-end mb-12 border-b border-surface-variant pb-6">
            <div>
                <h1 class="font-headline-md text-headline-md text-primary mb-2">My Wishlist</h1>
                <p class="text-secondary font-body-lg text-body-lg">Your curated collection of skincare essentials.</p>
            </div>
            <div class="text-secondary font-label-md text-label-md" id="wishlist-count">
                @Model.Count() Items Saved
            </div>
        </div>

        @if (!Model.Any())
        {
            <!-- Empty State -->
            <div class="p-12 border border-dashed border-outline-variant rounded-xl flex flex-col items-center justify-center text-center bg-surface-container-low/30">
                <span class="material-symbols-outlined text-4xl text-secondary mb-4 opacity-50">favorite_border</span>
                <h4 class="font-headline-sm text-headline-sm text-primary mb-2">Your Wishlist is Empty</h4>
                <p class="text-secondary font-body-md text-body-md max-w-md mb-6">Explore our collections to find skincare essentials tailored to your unique needs.</p>
                <a asp-controller="Home" asp-action="Index" class="border border-outline text-primary font-label-md text-label-md px-6 py-3 rounded-lg hover:bg-surface-variant transition-colors duration-200">
                    Explore Products
                </a>
            </div>
        }
        else
        {
            <!-- Bento Grid layout for products -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter" id="wishlist-grid">
                @foreach (var item in Model)
                {
                    var product = item.Product;
                    var imageUrl = product?.Images?.FirstOrDefault()?.ImageUrl ?? "/images/default-product.jpg";

                    <div class="group relative bg-surface-container-lowest rounded-xl p-6 ambient-shadow flex flex-col h-full transition-transform duration-300 hover:-translate-y-1" data-product-id="@product.Id">

                        <!-- صورة المنتج -->
                        <div class="w-full h-64 md:h-80 mb-6 bg-surface-variant rounded-lg overflow-hidden relative">
                            <img class="object-cover w-full h-full transform transition-transform duration-700 group-hover:scale-105"
                                 src="@imageUrl"
                                 alt="@product.Name" />
                        </div>

                        <!-- معلومات المنتج -->
                        <div class="flex-1 flex flex-col justify-between">
                            <div>
                                <!-- الاسم + زر المفضلة بجانبه -->
                                <div class="flex items-start justify-between gap-3 mb-2">
                                    <h3 class="font-headline-sm text-headline-sm text-primary">@product.Name</h3>

                                    <button type="button"
                                            onclick="removeFromWishlist(@product.Id, this)"
                                            aria-label="Remove from wishlist"
                                            class="text-error hover:scale-110 transition-transform p-1 shrink-0">
                                        <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">favorite</span>
                                    </button>
                                </div>

                                <p class="text-secondary font-body-md text-body-md mb-4 line-clamp-2">@product.Description</p>
                            </div>

                            <!-- السعر وزر الإضافة للسلة -->
                            <div class="flex items-center justify-between mt-auto pt-4">
                                <span class="font-label-md text-label-md font-semibold text-primary">$@product.Price.ToString("F2")</span>

                                <button type="button"
                                        onclick="addToCart(@product.Id)"
                                        class="bg-primary text-on-primary font-label-md text-label-md px-6 py-3 rounded-lg hover:bg-surface-tint transition-colors duration-200 flex items-center gap-2">
                                    Add to Cart
                                    <span class="material-symbols-outlined text-sm">shopping_bag</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>

@section Scripts {
    <script>
        // 1. حذف المنتج من المفضلة فوراً
        function removeFromWishlist(productId, btn) {
            fetch('/Wishlist/RemoveFromWishlist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${productId}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const card = btn.closest('[data-product-id]');
                    card.remove();

                    const remainingCards = document.querySelectorAll('[data-product-id]');
                    const countElem = document.getElementById('wishlist-count');

                    if (countElem) {
                        countElem.innerText = `${remainingCards.length} Items Saved`;
                    }

                    if (remainingCards.length === 0) {
                        window.location.reload();
                    }
                }
            });
        }

        // 2. إضافة المنتج للسلة من المفضلة
        function addToCart(productId) {
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${productId}&quantity=1`
            })
            .then(response => {
                if (response.ok) {
                    alert('Product added to your cart successfully!');
                } else {
                    alert('Error adding product to cart.');
                }
            });
        }
    </script>
}