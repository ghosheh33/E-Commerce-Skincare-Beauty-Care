@model Product

@{
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";
    ViewData["Title"] = Model.Name + " - LUMINA SKIN";
    var mainImage = Model.Images?.FirstOrDefault()?.ImageUrl ?? "/images/default-product.jpg";

    double avgRating = ViewBag.AverageRating ?? 0.0;
    int reviewCount = ViewBag.ReviewCount ?? 0;
}

<!-- Product Details Section -->
<section class="max-w-container-max-width mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 md:grid-cols-2 gap-section-gap items-start pt-12 pb-section-gap">

    <!-- Left: Image Gallery (Dynamic) -->
    <div class="flex gap-gutter sticky top-32">
        <!-- Thumbnails List -->
        <div class="hidden md:flex flex-col gap-unit w-24">
            @if (Model.Images != null && Model.Images.Any())
            {
                @foreach (var img in Model.Images)
                {
                    <button type="button" class="w-full aspect-[3/4] overflow-hidden rounded ring-1 ring-transparent hover:ring-outline-variant opacity-80 hover:opacity-100 transition-all cursor-pointer bg-surface-container thumbnail-btn" onclick="document.getElementById('mainProductImage').src = '@img.ImageUrl';">
                        <img class="w-full h-full object-cover" src="@img.ImageUrl" alt="@Model.Name">
                    </button>
                }
            }
            else
            {
                <button class="w-full aspect-[3/4] overflow-hidden rounded ring-1 ring-primary-container bg-surface-container">
                    <img class="w-full h-full object-cover" src="/images/default-product.jpg" alt="@Model.Name">
                </button>
            }
        </div>

        <!-- Main Image -->
        <div class="flex-1 aspect-[4/5] md:aspect-[3/4] bg-surface-container rounded-lg overflow-hidden shadow-[0_4px_30px_rgba(74,69,62,0.08)] relative group">
            <img id="mainProductImage" class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105" src="@mainImage" alt="@Model.Name">
        </div>
    </div>

    <!-- Right: Product Details -->
    <div class="flex flex-col pt-8 md:pt-0">
        <div class="flex justify-between items-center mb-4">
            <nav class="flex text-on-surface-variant font-label-sm text-label-sm uppercase gap-2">
                <a class="hover:text-primary transition-colors" asp-controller="Products" asp-action="Index">Shop</a>
                <span>/</span>
                <span>Product Details</span>
            </nav>
            <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-primary bg-primary-fixed px-3 py-1 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                In Stock
            </span>
        </div>

        <!-- Title -->
        <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-2">@Model.Name</h1>

        <!-- Star Rating Section -->
        <div class="flex items-center gap-2 mb-4">
            <div class="flex text-amber-500">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Floor(avgRating))
                    {
                        <!-- نجمة كاملة -->
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1; font-size: 20px;">star</span>
                    }
                    else if (i - avgRating <= 0.5 && i - avgRating > 0)
                    {
                        <!-- نصف نجمة -->
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1; font-size: 20px;">star_half</span>
                    }
                    else
                    {
                        <!-- نجمة فارغة -->
                        <span class="material-symbols-outlined text-outline-variant" style="font-variation-settings: 'FILL' 0; font-size: 20px;">star</span>
                    }
                }
            </div>
            <span class="font-label-md text-label-md font-semibold text-on-surface">@avgRating.ToString("0.0")</span>
            <span class="font-body-sm text-body-sm text-on-surface-variant">(@reviewCount @(reviewCount == 1 ? "review" : "reviews"))</span>
        </div>

        <!-- Price -->
        <div class="flex items-center gap-4 mb-6">
            <span class="font-headline-sm text-headline-sm text-secondary">$@Model.Price.ToString("F2")</span>
        </div>

        <!-- Description -->
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 leading-relaxed">
            @Model.Description
        </p>

        <!-- Messages -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 p-3 text-sm text-error bg-error-container rounded">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Add to Cart & Wishlist Form -->
        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex flex-col sm:flex-row gap-4 mb-12">
            <input type="hidden" name="productId" value="@Model.Id" />

            <!-- Quantity Counter -->
            <div class="flex items-center border border-tertiary rounded h-14 w-full sm:w-32 justify-between px-4 bg-surface focus-within:border-primary transition-colors">
                <button type="button"
                        onclick="var q = document.getElementById('qtyInput'); if(parseInt(q.value) > 1) q.value = parseInt(q.value) - 1;"
                        class="text-tertiary hover:text-primary transition-colors flex items-center justify-center">
                    <span class="material-symbols-outlined text-sm">remove</span>
                </button>

                <input type="number"
                       id="qtyInput"
                       name="quantity"
                       value="1"
                       min="1"
                       max="@Model.StockQuantity"
                       class="w-12 text-center bg-transparent border-none focus:ring-0 font-body-md text-on-surface font-semibold pointer-events-none"
                       readonly />

                <button type="button"
                        onclick="var q = document.getElementById('qtyInput'); if(parseInt(q.value) < @Model.StockQuantity) q.value = parseInt(q.value) + 1;"
                        class="text-tertiary hover:text-primary transition-colors flex items-center justify-center">
                    <span class="material-symbols-outlined text-sm">add</span>
                </button>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="flex-1 bg-primary text-on-primary h-14 rounded font-label-md text-label-md uppercase hover:bg-surface-tint transition-colors duration-300 flex items-center justify-center gap-2">
                <span>Add To Cart</span>
                <span class="material-symbols-outlined">shopping_bag</span>
            </button>

            <!-- Wishlist Button -->
            <button type="button"
                    id="wishlist-btn"
                    onclick="toggleWishlist(@Model.Id)"
                    title="Add to Favorite"
                    class="w-full sm:w-14 h-14 border border-outline hover:border-primary text-primary hover:bg-primary-fixed/30 rounded flex items-center justify-center transition-all duration-300 group">
                <span id="wishlist-icon"
                      class="material-symbols-outlined group-hover:scale-110 transition-transform"
                      style="font-variation-settings: 'FILL' @(ViewBag.IsInWishlist == true ? 1 : 0);">
                    favorite
                </span>
            </button>
        </form>
    </div>
</section>

<!-- Customer Reflections Section -->
<section class="mt-section-gap mb-section-gap px-margin-mobile md:px-margin-desktop max-w-container-max-width mx-auto">
    <div class="text-center mb-16">
        <h2 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-4">Customer Reflections</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">Real experiences from our community, finding calm and clarity with @Model.Name.</p>
    </div>

    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
            @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
            {
                var userName = review.User?.UserName ?? "Anonymous";
                var userInitial = userName.Substring(0, 1).ToUpper();

                <div class="bg-surface-container-low p-8 rounded-lg shadow-[0_4px_20px_rgba(74,69,62,0.03)] border border-outline-variant/20 hover:shadow-[0_8px_30px_rgba(74,69,62,0.06)] transition-shadow duration-300 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex text-primary">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Rating)
                                    {
                                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1; font-size: 20px;">star</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-outline-variant" style="font-variation-settings: 'FILL' 1; font-size: 20px;">star</span>
                                    }
                                }
                            </div>
                            <span class="font-label-sm text-label-sm text-outline">
                                @review.CreatedAt.ToString("MMM dd, yyyy")
                            </span>
                        </div>

                        <p class="font-body-md text-body-md text-on-surface-variant mb-6 italic">
                            "@review.Comment"
                        </p>
                    </div>

                    <div class="flex items-center gap-3 border-t border-outline-variant/30 pt-4">
                        <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center font-headline-sm text-headline-sm text-on-secondary-container">
                            @userInitial
                        </div>
                        <div>
                            <p class="font-label-md text-label-md text-on-surface">@userName</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-12 bg-surface-container-low rounded-lg border border-outline-variant/20">
            <p class="font-body-lg text-on-surface-variant">No reflections yet for this product. Be the first to share your experience!</p>
        </div>
    }
</section>

@section Scripts {
    <script>
        function toggleWishlist(productId) {
            fetch('/Wishlist/ToggleWishlist', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `productId=${productId}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const icon = document.getElementById('wishlist-icon');
                    if (data.isAdded) {
                        icon.style.fontVariationSettings = "'FILL' 1";
                        icon.classList.add('text-error');
                    } else {
                        icon.style.fontVariationSettings = "'FILL' 0";
                        icon.classList.remove('text-error');
                    }
                }
            })
            .catch(err => console.error("Error toggling wishlist:", err));
        }
    </script>
}