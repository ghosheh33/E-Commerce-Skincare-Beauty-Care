    px-margin-mobile md:px-margin-desktop
    max-w-container-max-width mx-auto">

    <div class="grid grid-cols-1 md:grid-cols-3
        gap-gutter auto-rows-[300px]">


        <!-- Sustainable -->
        <div class="md:col-span-2
            relative overflow-hidden
            rounded-xl
            shadow-[0_10px_40px_rgba(74,69,62,0.05)]
            bg-surface group">

            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCwiCC6iyjuMP3Omlm4cIS1IUy1LtiNRZt0aAt-9VReZPu4FM0qRlINdoygavMm006xqnpuVCr_zEG_NsDYtDKk_3xR9GX2_e7BwTF9gF1lByYtXG9jTtY6D0duYM4dDzB8b1WfvZZYGF7pOhnIThFNuEmQcCOXsbHTG0iJsvORfc8ZdR10JMX2x_rzrgz8RLQtmhWIwSL6tREIDy0NEVYdNdBlgZtZRHWAc01USgrrSG-el72x0Zd92w"
                 alt="Botanical Source"
                 class="absolute inset-0 w-full h-full
            object-cover
            group-hover:scale-[1.03]
            transition-transform duration-700" />

            <div class="absolute inset-0
