@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";
}

<!-- About Hero -->
<section class="pt-32 pb-section-gap
    px-margin-mobile md:px-margin-desktop
    max-w-container-max-width mx-auto">

    <div class="grid grid-cols-1 lg:grid-cols-12
        gap-gutter items-center min-h-[650px]">

        <!-- Text -->
        <div class="lg:col-span-5
            order-2 lg:order-1
            flex flex-col justify-center
            space-y-6 lg:pr-12">

            <span class="font-label-sm text-label-sm
                text-secondary uppercase tracking-widest">

                Botanical Purity, Clinical Efficacy

            </span>


            <h1 class="font-display-lg-mobile md:font-display-lg
                text-display-lg-mobile md:text-display-lg
                text-primary">

                The Art of Radiant Skin.

            </h1>


            <p class="font-body-lg text-body-lg
                text-on-surface-variant leading-relaxed">

                Born from a desire to harmonize nature's most potent
                botanicals with uncompromising clinical science.
                Lumina Skin is more than a routine; it is a ritual
                of self-reverence.

            </p>


            <p class="font-body-md text-body-md
                text-secondary leading-relaxed">

                Our journey began in a small botanical garden,
                exploring the delicate balance of flora.
                Today, that same reverence for nature guides
                every formula we curate.

            </p>

        </div>


        <!-- Image -->
        <div class="lg:col-span-7 order-1 lg:order-2">

            <div class="relative w-full
                aspect-[4/5] lg:aspect-square
                overflow-hidden rounded-xl
                shadow-[0_20px_60px_rgba(74,69,62,0.08)]
                bg-surface-container-low group">

                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBFX0tR3oKeudF5-H9XkDfU15BRrd8RPSir36WvtcWAaVXgc2Zs84TGTg2JGSCC9PffHbS2A6akeqMOqen4rmMk3konnPaEfCFQXHcU0rLqPjEIptgmz3SRCaTPme5N7UkLT2j9grFZz5j8o9u-o3FZtSw7xzqpy2o8jjafaM4YBFdSFJ9wpIBQHzsjK_EuDFFTzb16Q35q6hybTmUtCyP5u_oNOZoVMH9nb2pXuXfGruUUQ4kf4452oA"
                     alt="Lumina Skin Botanical Ingredients"
                     class="w-full h-full object-cover
                group-hover:scale-105
                transition-transform duration-700" />

            </div>

        </div>

    </div>

</section>



<!-- Values -->
