                text-on-tertiary-fixed-variant mb-3">
                Cruelty Free
            </h3>

            <p class="font-body-md text-body-md
                text-on-surface-variant">
                Beauty should never come at the cost
                of another living being.
            </p>

        </div>


        <!-- Texture Image -->
        <div class="md:col-span-2
            relative overflow-hidden
            rounded-xl
            shadow-[0_10px_40px_rgba(74,69,62,0.05)]
            bg-surface group">

            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDiCPMfuccPMYJMzJHrKXehbDRx0i3YU-A60QtQC3DK4Zz9Mj7LBtZ4A9f4bWqbXdPR6hPxWPzQnnVIXtwCHb9jYfclplJHvyRAmB_jfkpR1DdGdpmHd1j__Un7IJhwLiWGmFc6XsTeAvct2fSe3hMlbN_aKxc0Dv2uBFK1doqiurr3Q4yK-lr0PZ89pH3pPM-NZNXq1IPMuxpktQSQVlNuNF0RF8n3h0dZWH3PgrGaP4v2yfRrOGF-PA"
                 alt="Product Texture"
                 class="absolute inset-0 w-full h-full
            object-cover
            group-hover:scale-[1.03]
            transition-transform duration-700" />

        </div>

    </div>

</section>
<!-- =========================
     SHARE YOUR STORY
========================== -->
<section class="pb-section-gap
    px-margin-mobile md:px-margin-desktop
    max-w-container-max-width mx-auto">
 
    <div id="testimonial-form"
         class="max-w-3xl mx-auto
        bg-surface-container-low
        rounded-xl
        p-8 md:p-12
        scroll-mt-28">

        <!-- Header -->
        <div class="text-center mb-8">

            <p class="font-label-sm text-label-sm
                text-secondary uppercase
                tracking-widest mb-3">
                Lumina Community
            </p>

            <h2 class="font-headline-md text-headline-md
                text-primary mb-4">
                Share Your Story
            </h2>

            <p class="font-body-md text-body-md
                text-on-surface-variant">
                Tell us about your Lumina Skin experience.
                Your story will be reviewed before appearing
                on our community page.
            </p>

        </div>


        <!-- Success Message -->
        @if (TempData["TestimonialSuccess"] != null)
        {
            <div id="testimonial-message"
                 class="mb-6 p-4
                rounded-lg
                bg-primary/10
                text-primary
                text-center
                scroll-mt-28">

                @TempData["TestimonialSuccess"]

            </div>
        }


        <!-- Error Message -->
           @if (TempData["TestimonialError"] != null)
        {
            <div id="testimonial-message"
                 class="mb-6 p-4
                rounded-lg
                bg-red-50
                text-red-700
                text-center
                scroll-mt-28">

                @TempData["TestimonialError"]

            </div>
        }

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <!-- Testimonial Form -->
            <form asp-controller="Community"
                  asp-action="SubmitTestimonial"
                  method="post"
                  class="space-y-6">

                @Html.AntiForgeryToken()


                <div>

                    <label for="content"
                           class="block
                        font-label-sm text-label-sm
                        text-on-surface-variant
                        mb-2">

                        YOUR STORY

                    </label>


                    <textarea id="content"
                              name="content"
                              rows="6"
                              required
                              placeholder="Tell us about your skincare experience..."
                              class="w-full
                    bg-surface
                    border border-outline
                    rounded-lg
                    px-4 py-3
                    font-body-md text-body-md
                    text-on-surface
                    focus:outline-none
                    focus:border-primary
                    focus:ring-1
                    focus:ring-primary
                    resize-none"></textarea>

                </div>


                <div class="flex justify-center">

                    <button type="submit"
                            class="bg-primary
                        text-on-primary
                        font-label-md text-label-md
                        px-8 py-3
                        rounded-full
                        hover:opacity-90
                        transition-opacity">

                        Submit Testimonial

                    </button>

                </div>

            </form>
        }
        else
        {
            <!-- Guest User -->
            <div class="text-center">

                <p class="font-body-md text-body-md
                    text-secondary mb-6">
                    Sign in to share your experience with
                    the Lumina community.
                </p>


                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="inline-block
                    bg-primary
                    text-on-primary
                    px-8 py-3
                    rounded-full
                    font-label-md text-label-md
                    hover:opacity-90
                    transition-opacity">

                    Sign In to Share

                </a>

            </div>
        }

    </div>

</section>