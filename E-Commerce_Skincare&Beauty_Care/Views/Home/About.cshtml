                    text-on-primary mb-2">
                    Sustainable Sourcing
                </h3>

                <p class="font-body-md text-body-md
                    text-on-primary/90">
                    Rooted in respect for the earth.
                </p>

            </div>

        </div>


        <!-- Clinical Precision -->
        <div class="rounded-xl
            shadow-[0_10px_40px_rgba(74,69,62,0.05)]
            bg-surface-container-low
            p-8 flex flex-col
            justify-center items-center text-center">

            <span class="material-symbols-outlined
                text-primary mb-4 text-4xl">
                science
            </span>

            <h3 class="font-headline-sm text-headline-sm
                text-primary mb-3">
                Clinical Precision
            </h3>

            <p class="font-body-md text-body-md text-secondary">
                Every formula is rigorously tested to ensure efficacy
                without compromising the skin's natural barrier.
            </p>

        </div>


        <!-- Cruelty Free -->
        <div class="rounded-xl
            shadow-[0_10px_40px_rgba(74,69,62,0.05)]
