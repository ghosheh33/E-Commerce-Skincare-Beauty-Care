@model E_Commerce_Skincare_Beauty_Care.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_StorefrontLayout.cshtml";
}


<!-- =====================================
     HERO
===================================== -->
<section class="relative min-h-[819px]
    flex items-center justify-center
    bg-surface-container-low
    px-margin-mobile md:px-margin-desktop
    py-section-gap
    overflow-hidden">


    <!-- Background -->
    <div class="absolute inset-0 z-0">

        <div class="bg-cover
            bg-center
            bg-no-repeat
            w-full h-full
            opacity-60"
             style="background-image:
            url('https://lh3.googleusercontent.com/aida-public/AB6AXuBVPQml_dLaUUJN7YH1UwcX2D3sZkDTzybkyHDAaK03Hq91Lm9sfRJhd9LLQGXGGoUXgobuPmW8bMcKXD77eCh2UecD7EULL3LVbZUxJu_QzCo_076YAFf4Q4yPC2-RIouYZ_LNCogiPqg42UGieirXvRCHIK4iUaYl3RUjXHho-CZWU79e-01IuUJQ3cEMRz6kMD0pL_lMRcgcEsu5Yo2j1OBJsorWkd759igxZx0JUSOZjtZmbHyGXQ');">
        </div>

    </div>



    <!-- Hero Content -->
    <div class="relative z-10
        max-w-3xl mx-auto
        flex flex-col
        items-center
        text-center
        w-full">


        <h1 class="font-display-lg-mobile
            md:font-display-lg
            text-display-lg-mobile
            md:text-display-lg
            text-on-surface
            mb-6
            drop-shadow-sm">

            Purity in Every Drop

        </h1>


        <p class="font-body-lg
            text-body-lg
            text-on-surface-variant
            mb-10
            max-w-xl">

            Discover clinical efficacy wrapped in luxury.
            Our botanical formulations are designed to bring out
            your skin's natural, radiant calm.

        </p>



        <div class="flex flex-col
            sm:flex-row
            gap-4">


            <!-- Shop -->
            <a asp-controller="Store"
               asp-action="Index"
               class="bg-primary
                text-on-primary
                font-label-md
                text-label-md
                px-8 py-4
                rounded-full
                hover:opacity-80
                transition-opacity duration-200">

                Shop Now

            </a>



            <!-- Register -->
            @if (User.Identity == null ||
                 !User.Identity.IsAuthenticated)
            {
                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="bg-transparent
                    border border-outline
                    text-on-surface
                    font-label-md
                    text-label-md
                    px-8 py-4
                    rounded-full
                    hover:bg-surface-variant
                    transition-colors duration-200">

                    Sign Up

                </a>
            }

        </div>

    </div>

</section>



<!-- =====================================
     FEATURED PRODUCTS
===================================== -->
<section class="px-margin-mobile
    md:px-margin-desktop
    py-section-gap
    max-w-container-max-width
    mx-auto">


    <!-- Section Header -->
    <div class="flex flex-col
        md:flex-row
        md:items-end
        md:justify-between
        gap-6
        mb-12">


        <div>

            <p class="font-label-sm
                text-label-sm
                text-secondary
                uppercase
                tracking-widest
                mb-3">

                Our Essentials

            </p>


            <h2 class="font-headline-md
                text-headline-md
                text-on-surface
                mb-2">

                Featured Products

            </h2>


            <p class="font-body-md
                text-body-md
                text-secondary">

                Curated essentials for your daily ritual.

            </p>

        </div>



        <!-- Fixed View All -->
        <a asp-controller="Store"
           asp-action="Index"
           class="inline-flex
            items-center
            gap-2
            self-start md:self-auto
            font-label-md
            text-label-md
            text-primary
            border border-primary
            px-6 py-3
            rounded-full
            hover:bg-primary
            hover:text-on-primary
            transition-all duration-200">

            View All Products

            <span class="material-symbols-outlined text-lg">
                arrow_forward
            </span>

        </a>

    </div>



    @if (Model.FeaturedProducts != null &&
         Model.FeaturedProducts.Any())
    {
        <div class="grid grid-cols-1
            md:grid-cols-3
            gap-gutter">


            @foreach (var product in Model.FeaturedProducts)
            {
                var mainImage =
                    product.Images.FirstOrDefault(i => i.IsMainImage)
                    ?? product.Images.FirstOrDefault();

                var approvedReviews =
                    product.Reviews
                        .Where(r => r.IsApproved)
                        .ToList();

                var averageRating =
                    approvedReviews.Any()
                        ? approvedReviews.Average(r => r.Rating)
                        : 0;


                <article class="bg-surface
                    rounded-xl
                    shadow-[0_4px_20px_rgba(74,69,62,0.05)]
                    p-6
                    flex flex-col
                    group
                    hover:shadow-[0_8px_30px_rgba(74,69,62,0.08)]
                    transition-shadow duration-300">


                    <!-- Product Image -->
                    <div class="relative
                        aspect-[4/5]
                        mb-6
                        overflow-hidden
                        rounded-lg
                        bg-surface-container-low">


                        @if (mainImage != null)
                        {
                            <img src="@mainImage.ImageUrl"
                                 alt="@product.Name"
                                 class="object-cover
                            w-full h-full
                            group-hover:scale-105
                            transition-transform
                            duration-700" />
                        }
                        else
                        {
                            <div class="w-full h-full
                                flex items-center
                                justify-center
                                text-secondary">

                                <span class="material-symbols-outlined text-5xl">
                                    spa
                                </span>

                            </div>
                        }



                        <!-- Wishlist:
                             will connect with Aya later -->
                        <button type="button"
                                aria-label="Add to wishlist"
                                class="absolute
                            top-4 right-4
                            text-secondary
                            hover:text-primary
                            p-2
                            bg-surface/70
                            backdrop-blur-sm
                            rounded-full
                            transition-colors">

                            <span class="material-symbols-outlined">
                                favorite
                            </span>

                        </button>

                    </div>



                    <!-- Product Info -->
                    <div class="flex-1 flex flex-col">


                        <div class="flex
                            justify-between
                            items-start
                            gap-4
                            mb-2">


                            <a asp-controller="Details" asp-action="index" asp-route-id="@product.Id">
                                <h3 class="font-headline-sm
                                text-headline-sm
                                text-on-surface">

                                @product.Name

                            </h3></a>


                            <span class="font-label-md
                                text-label-md
                                text-on-surface
                                whitespace-nowrap">

                                $@product.Price.ToString("0.00")

                            </span>

                        </div>


                        <!-- Rating -->
                        <div class="flex
                            items-center
                            gap-2
                            mb-6
                            mt-auto">


                            <div class="flex
                                items-center
                                text-primary">

                                <span class="material-symbols-outlined
                                    text-sm"
                                      style="font-variation-settings: 'FILL' 1;">

                                    star

                                </span>


                                <span class="font-label-sm
                                    text-label-sm
                                    ml-1">

                                    @averageRating.ToString("0.0")

                                </span>

                            </div>


                            <span class="font-label-sm
                                text-label-sm
                                text-secondary">

                                (@approvedReviews.Count reviews)

                            </span>

                        </div>



                        <!-- Cart:
                             will connect with Aya later -->
                        <button type="button"
                                class="w-full
                            bg-surface
                            text-on-surface
                            border border-outline
                            font-label-md
                            text-label-md
                            py-3
                            rounded-full
                            hover:bg-primary
                            hover:text-on-primary
                            hover:border-primary
                            transition-all duration-200">

                            Add to Cart

                        </button>

                    </div>

                </article>
            }

        </div>
    }
    else
    {
        <div class="text-center
            py-16
            text-secondary">

            <span class="material-symbols-outlined
                text-5xl
                mb-4">

                spa

            </span>


            <p class="font-body-md text-body-md">

                No products available yet.

            </p>

        </div>
    }

</section>



<!-- =====================================
     SHOP BY CATEGORY
===================================== -->
<section class="bg-surface-container-low
    px-margin-mobile
    md:px-margin-desktop
    py-section-gap">


    <div class="max-w-container-max-width mx-auto">


        <!-- Header -->
        <div class="flex flex-col
            md:flex-row
            md:items-end
            md:justify-between
            gap-6
            mb-12">


            <div>

                <p class="font-label-sm
                    text-label-sm
                    text-secondary
                    uppercase
                    tracking-widest
                    mb-3">

                    Find Your Ritual

                </p>


                <h2 class="font-headline-md
                    text-headline-md
                    text-on-surface
                    mb-2">

                    Shop by Category

                </h2>


                <p class="font-body-md
                    text-body-md
                    text-secondary">

                    Discover products for every step
                    of your skincare routine.

                </p>

            </div>



            <a asp-controller="Catalog"
               asp-action="Index"
               class="inline-flex
                items-center
                gap-2
                self-start md:self-auto
                font-label-md
                text-label-md
                text-primary
                hover:opacity-80
                transition-opacity">

                View All Categories

                <span class="material-symbols-outlined text-lg">
                    arrow_forward
                </span>

            </a>

        </div>



        @if (Model.Categories != null &&
             Model.Categories.Any())
        {
            <div class="grid
                grid-cols-1
                sm:grid-cols-2
                lg:grid-cols-4
                gap-6">


                @foreach (var catalog in Model.Categories)
                {
                    <a asp-controller="Store"
                       asp-action="Index"
                       asp-route-catalogId="@catalog.Id"
                       class="group block">


                        <article class="relative
                            aspect-[4/5]
                            overflow-hidden
                            rounded-xl
                            bg-surface
                            shadow-[0_4px_20px_rgba(74,69,62,0.05)]">


                            @if (!string.IsNullOrWhiteSpace(catalog.CatalogImage))
                            {
                                <img src="@catalog.CatalogImage"
                                     alt="@catalog.Name"
                                     class="absolute inset-0
                                w-full h-full
                                object-cover
                                group-hover:scale-105
                                transition-transform
                                duration-700" />
                            }
                            else
                            {
                                <div class="absolute inset-0
                                    flex items-center
                                    justify-center
                                    bg-surface-container-high">

                                    <span class="material-symbols-outlined
                                        text-primary
                                        text-6xl">

                                        spa

                                    </span>

                                </div>
                            }



                            <!-- Overlay -->
                            <div class="absolute inset-0
                                bg-gradient-to-t
                                from-black/60
                                via-black/10
                                to-transparent">
                            </div>



                            <!-- Info -->
                            <div class="absolute
                                bottom-0
                                left-0 right-0
                                p-6
                                text-white">


                                <h3 class="font-headline-sm
                                    text-headline-sm
                                    mb-2">

                                    @catalog.Name

                                </h3>


                                <div class="inline-flex
                                    items-center
                                    gap-1
                                    font-label-md
                                    text-label-md">

                                    Shop Category

                                    <span class="material-symbols-outlined
                                        text-lg
                                        group-hover:translate-x-1
                                        transition-transform">

                                        arrow_forward

                                    </span>

                                </div>

                            </div>

                        </article>

                    </a>
                }

            </div>
        }
        else
        {
            <div class="text-center
                py-16
                text-secondary">

                No categories available yet.

            </div>
        }

    </div>

</section>



<!-- =====================================
     RADIANT STORIES
===================================== -->

<section class="bg-surface-container-high px-margin-mobile md:px-margin-desktop py-section-gap">
    <div class="max-w-container-max-width mx-auto">

        <!-- Section Header -->
        <div class="text-center mb-16">
            <h2 class="font-headline-md text-headline-md text-on-surface mb-4">
                Radiant Stories
            </h2>
            <p class="font-body-md text-body-md text-secondary max-w-2xl mx-auto">
                Hear from our community about their journey to healthy, glowing skin.
            </p>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="mt-7">
                    <a asp-controller="Home"
                       asp-action="About"
                       asp-fragment="testimonial-form"
                       class="inline-flex items-center gap-2 bg-primary text-on-primary px-7 py-3 rounded-full font-label-md text-label-md hover:opacity-90 transition-opacity">
                        <span class="material-symbols-outlined">rate_review</span>
                        Share Your Story
                    </a>
                </div>
            }
        </div>

        @if (Model.Testimonials != null && Model.Testimonials.Any())
        {
            <div id="testimonial-slider-container" class="relative max-w-5xl mx-auto p-4">

                <div id="testimonial-slider" class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-6 scrollbar-hide py-4">
                    @foreach (var testimonial in Model.Testimonials)
                    {
                        var customerName = testimonial.User?.Name ?? "Lumina Customer";
                        var initial = customerName.Substring(0, 1).ToUpper();

                        <div class="snap-start shrink-0 w-full md:w-[calc(50%-12px)] bg-surface p-8 rounded-xl shadow-[0_4px_20px_rgba(74,69,62,0.05)] border border-surface-variant flex flex-col justify-between">
                            <div>
                                <!-- Quote -->
                                <div class="text-primary mb-6">
                                    <span class="material-symbols-outlined text-4xl">format_quote</span>
                                </div>
                                <p class="font-body-lg text-body-lg text-on-surface-variant italic mb-8">
                                    “@testimonial.Content”
                                </p>
                            </div>

                            <!-- User -->
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-full bg-primary text-on-primary flex items-center justify-center font-headline-sm text-headline-sm">
                                    @initial
                                </div>
                                <div>
                                    <h4 class="font-label-md text-label-md text-on-surface">
                                        @customerName
                                    </h4>
                                    <span class="font-label-sm text-label-sm text-secondary">
                                        Lumina Community
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <button onclick="moveTestimonialSlider(-1)" class="absolute top-1/2 -right-2 md:-right-6 -translate-y-1/2 bg-surface border border-surface-variant text-on-surface hover:bg-primary hover:text-on-primary w-11 h-11 rounded-full flex items-center justify-center transition-all duration-300 shadow-lg z-10 cursor-pointer">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>

                <button onclick="moveTestimonialSlider(1)" class="absolute top-1/2 -left-2 md:-left-6 -translate-y-1/2 bg-surface border border-surface-variant text-on-surface hover:bg-primary hover:text-on-primary w-11 h-11 rounded-full flex items-center justify-center transition-all duration-300 shadow-lg z-10 cursor-pointer">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>

            </div>
           

        }
        else
        {
            <div class="text-center py-12">
                <span class="material-symbols-outlined text-primary text-5xl mb-4">
                    format_quote
                </span>
                <p class="font-body-md text-body-md text-secondary">
                    No community stories available yet.
                </p>
            </div>
        }

    </div>
</section>

<style>
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

@section Scripts {
    <script>
        const tSlider = document.getElementById('testimonial-slider');
        const tContainer = document.getElementById('testimonial-slider-container');
        let tAutoPlayInterval;

        function moveTestimonialSlider(direction) {
            if (!tSlider) return;
            const firstCard = tSlider.querySelector('div');
            if (!firstCard) return;
            const scrollAmount = firstCard.clientWidth + 24;

            const maxScrollLeft = tSlider.scrollWidth - tSlider.clientWidth;

            if (direction === 1 && tSlider.scrollLeft <= 10) {
                tSlider.scrollTo({ left: maxScrollLeft, behavior: 'smooth' });
            } else if (direction === -1 && tSlider.scrollLeft >= maxScrollLeft - 10) {
                tSlider.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
                tSlider.scrollBy({ left: scrollAmount * direction * -1, behavior: 'smooth' });
            }
        }

        function startTestimonialAutoPlay() {
            tAutoPlayInterval = setInterval(() => {
                if (!tSlider) return;
                const firstCard = tSlider.querySelector('div');
                if (!firstCard) return;
                const scrollAmount = firstCard.clientWidth + 24;

                const maxScrollLeft = tSlider.scrollWidth - tSlider.clientWidth;

                if (tSlider.scrollLeft >= maxScrollLeft - 10) {
                    tSlider.scrollTo({ left: 0, behavior: 'smooth' });
                } else {
                    tSlider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                }
            }, 1000);
        }

        function stopTestimonialAutoPlay() {
            clearInterval(tAutoPlayInterval);
        }

        if (tContainer && tSlider) {
            tContainer.addEventListener('mouseenter', stopTestimonialAutoPlay);
            tContainer.addEventListener('mouseleave', startTestimonialAutoPlay);
            startTestimonialAutoPlay();
        }
    </script>

        }