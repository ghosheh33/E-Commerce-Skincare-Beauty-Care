<!DOCTYPE html>

<html class="light" lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Lumina Skin</title>


    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>


    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />


    <!-- Fonts -->
    <link href="https://fonts.googleapis.com"
          rel="preconnect" />

    <link crossorigin
          href="https://fonts.gstatic.com"
          rel="preconnect" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet"><!--Alert-->

    <!-- Tailwind Config -->
    <script id="tailwind-config">

        tailwind.config = {

            darkMode: "class",

            theme: {

                extend: {

                    colors: {

                        "outline": "#747872",
                        "on-tertiary-fixed-variant": "#484742",
                        "on-tertiary-container": "#fffbff",
                        "inverse-primary": "#bbcbb8",
                        "tertiary": "#5e5c57",
                        "on-tertiary": "#ffffff",
                        "on-background": "#1c1b1b",
                        "on-secondary-fixed-variant": "#474744",
                        "surface-container-high": "#eae7e7",
                        "surface": "#fcf9f8",
                        "inverse-surface": "#313030",
                        "primary-container": "#6a7868",
                        "on-surface-variant": "#444842",
                        "on-tertiary-fixed": "#1c1c18",
                        "on-secondary-container": "#636360",
                        "outline-variant": "#c4c8c0",
                        "on-surface": "#1c1b1b",
                        "on-primary-container": "#f7fff2",
                        "secondary-fixed-dim": "#c8c6c3",
                        "primary-fixed": "#d7e7d3",
                        "on-secondary-fixed": "#1b1c1a",
                        "surface-dim": "#dcd9d9",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#e4e2de",
                        "surface-container": "#f0eded",
                        "primary-fixed-dim": "#bbcbb8",
                        "error": "#ba1a1a",
                        "inverse-on-surface": "#f3f0ef",
                        "surface-bright": "#fcf9f8",
                        "on-primary-fixed-variant": "#3c4a3c",
                        "surface-container-low": "#f6f3f2",
                        "tertiary-fixed-dim": "#c9c6c0",
                        "background": "#fcf9f8",
                        "surface-variant": "#e5e2e1",
                        "error-container": "#ffdad6",
                        "tertiary-fixed": "#e6e2dc",
                        "on-primary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed": "#121f12",
                        "secondary-container": "#e1dfdc",
                        "primary": "#516050",
                        "tertiary-container": "#76746f",
                        "secondary": "#5e5e5c",
                        "surface-tint": "#546253",
                        "surface-container-highest": "#e5e2e1",
                        "on-error": "#ffffff"

                    },


                    borderRadius: {

                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"

                    },


                    spacing: {

                        "gutter": "24px",
                        "margin-mobile": "20px",
                        "container-max-width": "1280px",
                        "section-gap": "120px",
                        "unit": "8px",
                        "margin-desktop": "64px"

                    },


                    fontFamily: {

                        "body-md": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "display-lg": ["Playfair Display"],
                        "display-lg-mobile": ["Playfair Display"],
                        "headline-sm": ["Playfair Display"],
                        "headline-md": ["Playfair Display"],
                        "body-lg": ["Inter"]

                    },


                    fontSize: {

                        "body-md": [
                            "16px",
                            {
                                "lineHeight": "1.6",
                                "fontWeight": "400"
                            }
                        ],

                        "label-sm": [
                            "12px",
                            {
                                "lineHeight": "1.0",
                                "letterSpacing": "0.08em",
                                "fontWeight": "600"
                            }
                        ],

                        "label-md": [
                            "14px",
                            {
                                "lineHeight": "1.0",
                                "letterSpacing": "0.05em",
                                "fontWeight": "500"
                            }
                        ],

                        "display-lg": [
                            "48px",
                            {
                                "lineHeight": "1.1",
                                "letterSpacing": "-0.02em",
                                "fontWeight": "600"
                            }
                        ],

                        "display-lg-mobile": [
                            "32px",
                            {
                                "lineHeight": "1.2",
                                "fontWeight": "600"
                            }
                        ],

                        "headline-sm": [
                            "24px",
                            {
                                "lineHeight": "1.3",
                                "fontWeight": "500"
                            }
                        ],

                        "headline-md": [
                            "32px",
                            {
                                "lineHeight": "1.2",
                                "fontWeight": "500"
                            }
                        ],

                        "body-lg": [
                            "18px",
                            {
                                "lineHeight": "1.6",
                                "fontWeight": "400"
                            }
                        ]

                    }

                }

            }

        };

    </script>


    <style>

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }


            .material-symbols-outlined[style*="FILL' 1"] {
                font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }


        html {
            scroll-behavior: smooth;
        }


        body {
            background-color: #fcf9f8;
            color: #1c1b1b;
        }

    </style>

</head>


<body class="font-body-md
    text-body-md
    antialiased
    overflow-x-hidden
    pt-20">


    <!-- =========================
         NAVBAR
    ========================== -->
    <header class="fixed top-0 w-full z-50
        bg-surface/80
        backdrop-blur-md
        shadow-[0_4px_20px_rgba(74,69,62,0.05)]">

        <div class="grid
            grid-cols-[auto_1fr_auto]
            items-center
            gap-8
            h-20
            px-margin-mobile
            md:px-margin-desktop
            max-w-container-max-width
            mx-auto">


            <!-- Logo -->
            <div class="flex items-center shrink-0">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="font-headline-sm
                    text-headline-sm
                    tracking-tight
                    whitespace-nowrap
                    text-primary
                    hover:opacity-80
                    transition-opacity duration-200">

                    LUMINA SKIN

                </a>

            </div>



            <!-- Navigation -->
            <nav class="hidden md:flex
                items-center
                justify-center
                gap-7">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="font-label-md
                    text-label-md
                    text-secondary
                    hover:text-primary
                    transition-colors duration-200">

                    Home

                </a>


                <a asp-controller="Store"
                   asp-action="Index"
                   class="font-label-md
                    text-label-md
                    text-secondary
                    hover:text-primary
                    transition-colors duration-200">

                    Shop

                </a>


                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="font-label-md
                    text-label-md
                    text-secondary
                    hover:text-primary
                    transition-colors duration-200">

                    Categories

                </a>


                <a asp-controller="Home"
                   asp-action="About"
                   class="font-label-md
                    text-label-md
                    text-secondary
                    hover:text-primary
                    transition-colors duration-200">

                    About

                </a>
                

            </nav>



            <!-- Right Actions -->
            <div class="flex
                items-center
                justify-end
                gap-4
                shrink-0">

                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index"
                       class="text-secondary hover:text-primary transition-colors duration-200" title="Admin">
                       <span class="material-symbols-outlined text-[18px] mr-1">settings</span>
                    </a>
                }


                <!-- Search -->
                <a asp-controller="Store"
                   asp-action="Index"
                   aria-label="Search"
                   class="text-secondary
                    hover:text-primary
                    transition-colors duration-200">

                    <span class="material-symbols-outlined">
                        search
                    </span>

                </a>



                <!-- Wishlist -->
                <a asp-controller="Wishlist" asp-action="Index"
                   aria-label="Wishlist"
                   class="text-secondary
                    hover:text-primary
                    transition-colors duration-200">

                    <span class="material-symbols-outlined">
                        favorite
                    </span>

                </a>



                <!-- Cart -->
                <a asp-controller="Cart" asp-action="Index"
                        aria-label="Cart"
                        class="text-secondary
                    hover:text-primary
                    transition-colors duration-200">

                    <span class="material-symbols-outlined">
                        shopping_bag
                    </span>

                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Profile"
                       asp-action="Index"
                       aria-label="My Profile"
                       title="My Profile"
                       class="text-secondary
                        hover:text-primary
                        transition-colors duration-200">

                        <span class="material-symbols-outlined">
                            account_circle
                        </span>

                    </a>
                }

                <!-- Authentication -->
                @if (User.Identity != null &&
                User.Identity.IsAuthenticated)
                {
                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/"
                          method="post">

                        <button type="submit"
                                class="hidden md:flex
                            items-center
                            gap-2
                            whitespace-nowrap
                            font-label-md
                            text-label-md
                            text-primary
                            border
                            border-primary
                            px-5 py-2
                            rounded-full
                            hover:bg-primary
                            hover:text-on-primary
                            transition-all duration-200">

                            <span class="material-symbols-outlined text-lg">
                                logout
                            </span>

                            Sign Out

                        </button>

                    </form>
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="hidden md:block
                        whitespace-nowrap
                        font-label-md
                        text-label-md
                        text-on-primary
                        bg-primary
                        px-5 py-2
                        rounded-full
                        hover:opacity-80
                        transition-opacity duration-200">

                        Sign In

                    </a>
                }

            </div>
            <!-- END Right Actions -->


        </div>
        <!-- END Navbar Container -->


    </header>
    <!-- END Navbar -->
    <!-- =========================
         MAIN CONTENT
    ========================== -->
    <main>

        @RenderBody()

    </main>



    <!-- =========================
         FOOTER
    ========================== -->
    <footer class="w-full
        bg-secondary-fixed
        dark:bg-surface-container-highest">

        <div class="grid
            grid-cols-1
            md:grid-cols-4
            gap-section-gap
            px-margin-mobile
            md:px-margin-desktop
            py-section-gap
            max-w-container-max-width
            mx-auto">


            <!-- Brand -->
            <div class="flex flex-col gap-4">

                <span class="font-display-lg
                    text-display-lg
                    text-primary">
                    LUMINA SKIN
                </span>

                <p class="font-body-md
                    text-body-md
                    text-on-secondary-fixed-variant
                    dark:text-on-surface-variant">

                    Purity in every drop. Discover calm,
                    radiant skin with our carefully curated
                    botanical blends.

                </p>

            </div>



            <!-- Explore -->
            <div class="flex flex-col gap-4">

                <h4 class="font-label-sm
                    text-label-sm
                    text-on-secondary-fixed-variant
                    uppercase
                    tracking-wider">

                    Explore

                </h4>


                <a asp-controller="Store"
                   asp-action="Index"
                   class="font-body-md
                    text-body-md
                    text-on-secondary-fixed-variant
                    hover:text-primary
                    hover:underline">

                    Shop

                </a>


                <a asp-controller="Home"
                   asp-action="About"
                   class="font-body-md
                    text-body-md
                    text-on-secondary-fixed-variant
                    hover:text-primary
                    hover:underline">

                    About

                </a>

            </div>



            <!-- Customer Care -->
            <div class="flex flex-col gap-4">

                <h4 class="font-label-sm
                    text-label-sm
                    text-on-secondary-fixed-variant
                    uppercase
                    tracking-wider">

                    Customer Care

                </h4>


                <a href="#"
                   class="font-body-md
                    text-body-md
                    text-on-secondary-fixed-variant
                    hover:text-primary
                    hover:underline">

                    Shipping

                </a>


                <a href="#"
                   class="font-body-md
                    text-body-md
                    text-on-secondary-fixed-variant
                    hover:text-primary
                    hover:underline">

                    Sustainability

                </a>


                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="font-body-md
                    text-body-md
                    text-on-secondary-fixed-variant
                    hover:text-primary
                    hover:underline">

                    Privacy

                </a>

            </div>



            <!-- Community -->
            <div class="flex flex-col gap-4">

                <h4 class="font-label-sm
                    text-label-sm
                    text-on-secondary-fixed-variant
                    uppercase
                    tracking-wider">

                    Join Our Community

                </h4>


                <p class="font-body-md
                    text-body-md
                    text-on-secondary-fixed-variant">

                    Sign up for updates on new rituals
                    and exclusive offers.

                </p>


                <div class="flex mt-2">

                    <input type="email"
                           placeholder="Email Address"
                           class="bg-surface
                    text-on-surface
                    border border-outline
                    rounded-l-md
                    px-4 py-2
                    flex-1
                    min-w-0
                    focus:outline-none
                    focus:border-primary" />


                    <button type="button"
                            class="bg-primary
                        text-on-primary
                        px-4 py-2
                        rounded-r-md
                        hover:opacity-90">

                        <span class="material-symbols-outlined">
                            arrow_forward
                        </span>

                    </button>

                </div>

            </div>

        </div>



        <!-- Copyright -->
        <div class="border-t
            border-outline-variant/30
            px-margin-mobile
            md:px-margin-desktop
            py-6">

            <div class="max-w-container-max-width
                mx-auto
                flex
                justify-between
                items-center
                flex-col
                md:flex-row
                gap-4">

                <span class="font-body-md
                    text-body-md
                    text-on-secondary-fixed-variant
                    text-sm">

                    © 2024 Lumina Skin. All rights reserved.

                </span>


                <div class="flex gap-4">

                    <a href="#"
                       class="text-on-secondary-fixed-variant
                        hover:text-primary">
                        Instagram
                    </a>

                    <a href="#"
                       class="text-on-secondary-fixed-variant
                        hover:text-primary">
                        TikTok
                    </a>

                </div>

            </div>

        </div>

    </footer>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script><!--Alert-->
    <script>
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,

            background: '#ffffff',
            color: '#1f2937',
            iconColor: '#10b981',

            // 2. السحر الحقيقي: حقن كلاسات Tailwind CSS
            customClass: {
                popup: 'rounded-xl shadow-lg border border-gray-100 mt-4 mr-4',
                title: 'font-body-md font-medium text-sm',
            },

            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });
    </script>

    @if (TempData["Success"] != null)
    {
        <script>
            Toast.fire({
                icon: 'success',
                title: '@TempData["Success"]',
                iconColor: '#10b981',
                background: '#ecfdf5',
                color: '#065f46'
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Toast.fire({
                icon: 'error',
                title: '@TempData["Error"]',
                iconColor: '#ef4444',
                background: '#fef2f2',
                color: '#991b1b'
            });
        </script>
    }

    @if (TempData["Info"] != null)
    {
        <script>
            Toast.fire({
                icon: 'info',
                title: '@TempData["Info"]'
            });
        </script>
    }


    <!-- Page Specific Scripts -->
    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>