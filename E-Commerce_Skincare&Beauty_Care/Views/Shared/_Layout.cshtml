<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <!-- تخصيص عنوان الصفحة ديناميكياً -->
    <title>@ViewData["Title"] - Lumina Skin</title>

    <!-- Scripts & Fonts -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- Tailwind Config -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "outline": "#747872",
                        "on-tertiary-fixed-variant": "#484742",
                        "on-tertiary-container": "#fffbff",
                        "inverse-primary": "#bbcbb8",
                        "tertiary": "#5e5c57",
                        "on-tertiary": "#ffffff",
                        "on-background": "#1c1b1b",
                        "on-secondary-fixed-variant": "#474744",
                        "surface-container-high": "#eae7e7",
                        "surface": "#fcf9f8",
                        "inverse-surface": "#313030",
                        "primary-container": "#6a7868",
                        "on-surface-variant": "#444842",
                        "on-tertiary-fixed": "#1c1c18",
                        "on-secondary-container": "#636360",
                        "outline-variant": "#c4c8c0",
                        "on-surface": "#1c1b1b",
                        "on-primary-container": "#f7fff2",
                        "secondary-fixed-dim": "#c8c6c3",
                        "primary-fixed": "#d7e7d3",
                        "on-secondary-fixed": "#1b1c1a",
                        "surface-dim": "#dcd9d9",
                        "on-error-container": "#93000a",
                        "secondary-fixed": "#e4e2de",
                        "surface-container": "#f0eded",
                        "primary-fixed-dim": "#bbcbb8",
                        "error": "#ba1a1a",
                        "inverse-on-surface": "#f3f0ef",
                        "surface-bright": "#fcf9f8",
                        "on-primary-fixed-variant": "#3c4a3c",
                        "surface-container-low": "#f6f3f2",
                        "tertiary-fixed-dim": "#c9c6c0",
                        "background": "#fcf9f8",
                        "surface-variant": "#e5e2e1",
                        "error-container": "#ffdad6",
                        "tertiary-fixed": "#e6e2dc",
                        "on-primary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed": "#121f12",
                        "secondary-container": "#e1dfdc",
                        "primary": "#516050",
                        "tertiary-container": "#76746f",
                        "secondary": "#5e5e5c",
                        "surface-tint": "#546253",
                        "surface-container-highest": "#e5e2e1",
                        "on-error": "#ffffff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "gutter": "24px",
                        "margin-mobile": "20px",
                        "container-max-width": "1280px",
                        "section-gap": "120px",
                        "unit": "8px",
                        "margin-desktop": "64px"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "display-lg": ["Playfair Display"],
                        "display-lg-mobile": ["Playfair Display"],
                        "headline-sm": ["Playfair Display"],
                        "headline-md": ["Playfair Display"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "label-sm": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.08em", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "500" }],
                        "display-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "headline-sm": ["24px", { "lineHeight": "1.3", "fontWeight": "500" }],
                        "headline-md": ["32px", { "lineHeight": "1.2", "fontWeight": "500" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

            .material-symbols-outlined[style*="FILL' 1"] {
                font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: theme('colors.background');
            color: theme('colors.on-background');
        }
    </style>
</head>
<body class="font-body-md text-body-md antialiased overflow-x-hidden pt-20">

    <!-- TopNavBar (Shared Component) -->
    <header class="fixed top-0 w-full z-50 bg-surface/80 dark:bg-surface-container-high/80 backdrop-blur-md shadow-[0_4px_20px_rgba(74,69,62,0.05)]">
        <div class="flex justify-between items-center h-20 px-margin-mobile md:px-margin-desktop max-w-container-max-width mx-auto">

            <!-- Center: Brand Logo -->
            <div class="flex-1 flex justify-center md:justify-center justify-start">
                <a class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg tracking-tighter text-primary dark:text-inverse-primary hover:opacity-80 transition-opacity duration-200" href="/">
                    LUMINA SKIN
                </a>
            </div>
            
            <!-- Left: Search -->
            <div class="hidden md:flex flex-1 items-center gap-2 text-secondary dark:text-secondary-fixed-dim hover:opacity-80 transition-opacity duration-200 cursor-pointer">
                <span class="material-symbols-outlined" data-icon="search">search</span>
                <span class="font-label-md text-label-md">Search</span>
            </div>
           
            <!-- Right: Actions & Nav -->
            <div class="flex-1 flex justify-end items-center gap-6">
                <nav class="hidden md:flex gap-6 items-center">
                    <a class="font-label-md text-label-md text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors duration-200" href="#">Shop</a>
                    <a class="font-label-md text-label-md text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors duration-200" href="#">About</a>
                    <a class="font-label-md text-label-md text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors duration-200" href="#">Treatments</a>
                    <a class="font-label-md text-label-md text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors duration-200" href="#">Journal</a>
                </nav>
                <div class="flex items-center gap-4">
                    <button class="text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors duration-200"><span class="material-symbols-outlined">favorite</span></button>
                    <button class="text-secondary dark:text-secondary-fixed-dim hover:text-primary transition-colors duration-200"><span class="material-symbols-outlined">shopping_bag</span></button>
                    <a class="hidden whitespace-nowrap md:block font-label-md text-label-md text-on-primary bg-primary px-5 py-2 rounded-full hover:opacity-80 transition-opacity" href="#">Sign In</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Wrapper -->
    <main>
        @RenderBody()
        <!-- ملاحظة: إذا كنت تستخدم بيئة PHP الخالصة، يمكنك استخدام include للمحتوى هنا -->
    </main>

    <!-- Footer (Shared Component) -->
    <footer class="w-full bg-secondary-fixed dark:bg-surface-container-highest">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-section-gap px-margin-mobile md:px-margin-desktop py-section-gap max-w-container-max-width mx-auto">
            <!-- Brand Column -->
            <div class="flex flex-col gap-4">
                <span class="font-display-lg text-display-lg text-primary">LUMINA SKIN</span>
                <p class="font-body-md text-body-md text-on-secondary-fixed-variant dark:text-on-surface-variant">Purity in every drop. Discover calm, radiant skin with our carefully curated botanical blends.</p>
            </div>
            <!-- Links Column 1 -->
            <div class="flex flex-col gap-4">
                <h4 class="font-label-sm text-label-sm text-on-secondary-fixed-variant dark:text-on-surface-variant uppercase tracking-wider">Explore</h4>
                <a class="font-body-md text-body-md text-on-secondary-fixed-variant dark:text-on-surface-variant hover:text-primary hover:underline transition-all" href="#">Shop</a>
                <a class="font-body-md text-body-md text-on-secondary-fixed-variant dark:text-on-surface-variant hover:text-primary hover:underline transition-all" href="#">About</a>
                <a class="font-body-md text-body-md text-on-secondary-fixed-variant dark:text-on-surface-variant hover:text-primary hover:underline transition-all" href="#">Contact</a>
            </div>
            <!-- Links Column 2 -->
            <div class="flex flex-col gap-4">
                <h4 class="font-label-sm text-label-sm text-on-secondary-fixed-variant dark:text-on-surface-variant uppercase tracking-wider">Customer Care</h4>
                <a class="font-body-md text-body-md text-on-secondary-fixed-variant dark:text-on-surface-variant hover:text-primary hover:underline transition-all" href="#">Shipping</a>
                <a class="font-body-md text-body-md text-on-secondary-fixed-variant dark:text-on-surface-variant hover:text-primary hover:underline transition-all" href="#">Sustainability</a>
                <a class="font-body-md text-body-md text-on-secondary-fixed-variant dark:text-on-surface-variant hover:text-primary hover:underline transition-all" href="#">Privacy</a>
            </div>
            <!-- Newsletter / Footer CTA -->
            <div class="flex flex-col gap-4">
                <h4 class="font-label-sm text-label-sm text-on-secondary-fixed-variant dark:text-on-surface-variant uppercase tracking-wider">Join Our Community</h4>
                <p class="font-body-md text-body-md text-on-secondary-fixed-variant dark:text-on-surface-variant">Sign up for updates on new rituals and exclusive offers.</p>
                <div class="flex mt-2">
                    <input class="bg-surface text-on-surface border border-outline rounded-l-md px-4 py-2 flex-1 focus:outline-none focus:border-primary font-body-md text-body-md" placeholder="Email Address" type="email">
                    <button class="bg-primary text-on-primary px-4 py-2 rounded-r-md font-label-md text-label-md hover:opacity-90 transition-opacity">
                        <span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
                    </button>
                </div>
            </div>
        </div>
        <!-- Copyright Bottom -->
        <div class="border-t border-outline-variant/30 px-margin-mobile md:px-margin-desktop py-6">
            <div class="max-w-container-max-width mx-auto flex justify-between items-center flex-col md:flex-row gap-4">
                <span class="font-body-md text-body-md text-on-secondary-fixed-variant dark:text-on-surface-variant text-sm">© 2024 Lumina Skin. All rights reserved.</span>
                <div class="flex gap-4">
                    <a class="text-on-secondary-fixed-variant hover:text-primary transition-colors" href="#">Instagram</a>
                    <a class="text-on-secondary-fixed-variant hover:text-primary transition-colors" href="#">TikTok</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
   
    <!-- Page Specific Scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>