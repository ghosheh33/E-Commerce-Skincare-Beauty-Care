@model IEnumerable<Catalog>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main>
    <!-- Page Header & Actions -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12 gap-6">
        <div>
            <h1 class="font-headline-md text-headline-md text-primary mb-2">Catalogs Management</h1>
            <p class="font-body-md text-body-md text-secondary">Manage Name, Description, and Catalog Image.</p>
        </div>
    </div>

    <!-- Filters & Search Bar -->
    <div class="bg-surface-container-lowest rounded-xl ambient-shadow p-6 mb-8 flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="relative w-full md:w-96">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-secondary">search</span>

            <input id="searchInput" class="w-full pl-12 pr-4 py-3 bg-surface border border-tertiary-fixed-dim rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary font-body-md text-body-md transition-colors placeholder:text-secondary-fixed-dim"
                   name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Search Catalogs..." type="text">
        </div>
        <a asp-action="Create" class="flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-full font-label-md text-label-md hover:bg-surface-tint transition-colors shadow-sm whitespace-nowrap">
            <span class="material-symbols-outlined">add</span>
            Add New catalogue
        </a>
    </div>

    <!-- Product Data Table Container -->
    <div id="productTableContainer" class="bg-surface-container-lowest rounded-xl ambient-shadow overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-surface-variant">
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider w-30">
                            @Html.DisplayNameFor(model => model.Name)
                        </th>
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider w-30">
                            @Html.DisplayNameFor(model => model.Description)
                        </th>
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider w-24">
                            Image
                        </th>
                        
                        <th class="px-6 py-4 font-label-sm text-label-sm text-secondary uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-surface-container-lowest/50 transition-colors group">

                            <td class="px-6 py-4">
                                <span class="px-3 py-1 bg-tertiary-fixed text-on-tertiary-fixed-variant rounded-full font-label-sm text-label-sm">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </span>
                            </td>

                            <td class="px-6 py-4">
                                <p class="font-body-md text-body-md font-medium text-on-surface">@Html.DisplayFor(modelItem => item.Description)</p>
                            </td>
                           
                            
                            <td class="px-6 py-4">
                                <div class="w-16 h-16 rounded-lg overflow-hidden bg-surface-container">
                                    <img class="w-full h-full object-cover" src="@Html.DisplayFor(modelItem => item.CatalogImage)">
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2 transition-opacity">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="p-2 text-secondary hover:text-primary transition-colors" title="Edit"><span class="material-symbols-outlined text-[20px]">Edit</span></a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="p-2 text-secondary hover:text-error transition-colors" title="Delete"><span class="material-symbols-outlined text-[20px]">Delete</span></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
       
    </div>
    
</main>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');

        searchInput.addEventListener('input', function () {
            let query = this.value;

            fetch(`/Catalogs/Index?searchString=${encodeURIComponent(query)}`)
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newContainer = doc.getElementById('productTableContainer');

                    if (newContainer) {
                        document.getElementById('productTableContainer').innerHTML = newContainer.innerHTML;
                    }
                })
                .catch(error => console.error('Error:', error));
        });
    </script>
}